{
  "name": "bmux-live-monitoring",
  "services": {
    "prometheus": {
      "image": "${MONITORING_PROMETHEUS_IMAGE:?Run scripts/check-live-monitoring-images.py successfully before startup}",
      "restart": "unless-stopped",
      "command": [
        "--config.file=/etc/prometheus/prometheus.json",
        "--storage.tsdb.path=/prometheus",
        "--storage.tsdb.retention.time=30d",
        "--storage.tsdb.retention.size=5GB"
      ],
      "ports": [
        "127.0.0.1:9090:9090"
      ],
      "volumes": [
        "./prometheus.json:/etc/prometheus/prometheus.json:ro",
        "./alerts.json:/etc/prometheus/alerts.json:ro",
        "prometheus-data:/prometheus"
      ],
      "secrets": [
        "relay_metrics_key"
      ],
      "mem_limit": "512m",
      "cpus": 1,
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "alertmanager": {
      "image": "${MONITORING_ALERTMANAGER_IMAGE:?Run scripts/check-live-monitoring-images.py successfully before startup}",
      "restart": "unless-stopped",
      "command": [
        "--config.file=/etc/alertmanager/alertmanager.json",
        "--storage.path=/alertmanager",
        "--data.retention=720h"
      ],
      "ports": [
        "127.0.0.1:9093:9093"
      ],
      "volumes": [
        "./alertmanager.json:/etc/alertmanager/alertmanager.json:ro",
        "alertmanager-data:/alertmanager"
      ],
      "secrets": [
        "alert_webhook"
      ],
      "mem_limit": "128m",
      "cpus": 0.5,
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "grafana": {
      "image": "${MONITORING_GRAFANA_IMAGE:?Run scripts/check-live-monitoring-images.py successfully before startup}",
      "restart": "unless-stopped",
      "ports": [
        "127.0.0.1:3000:3000"
      ],
      "environment": {
        "GF_SECURITY_ADMIN_PASSWORD__FILE": "/run/secrets/grafana_admin_password",
        "GF_USERS_ALLOW_SIGN_UP": "false",
        "GF_AUTH_ANONYMOUS_ENABLED": "false",
        "GF_ANALYTICS_REPORTING_ENABLED": "false",
        "GF_ANALYTICS_CHECK_FOR_UPDATES": "false"
      },
      "volumes": [
        "./grafana/provisioning:/etc/grafana/provisioning:ro",
        "./grafana/dashboards:/var/lib/grafana/dashboards:ro",
        "grafana-data:/var/lib/grafana"
      ],
      "secrets": [
        "grafana_admin_password"
      ],
      "mem_limit": "384m",
      "cpus": 1,
      "security_opt": [
        "no-new-privileges:true"
      ]
    }
  },
  "secrets": {
    "relay_metrics_key": {
      "file": "${MONITORING_METRICS_KEY_FILE:?Set the absolute private metrics-key file path}"
    },
    "alert_webhook": {
      "file": "${MONITORING_ALERT_WEBHOOK_FILE:?Set the absolute private Alertmanager webhook URL file path}"
    },
    "grafana_admin_password": {
      "file": "${MONITORING_GRAFANA_PASSWORD_FILE:?Set the absolute private Grafana administrator password file path}"
    }
  },
  "volumes": {
    "prometheus-data": {},
    "alertmanager-data": {},
    "grafana-data": {}
  }
}
