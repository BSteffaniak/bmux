{
  "global": {"scrape_interval": "15s", "evaluation_interval": "15s"},
  "rule_files": ["/etc/prometheus/alerts.json"],
  "alerting": {"alertmanagers": [{"static_configs": [{"targets": ["alertmanager:9093"]}]}]},
  "scrape_configs": [{
    "job_name": "bmux-relay",
    "scheme": "https",
    "metrics_path": "/metrics",
    "scrape_timeout": "5s",
    "follow_redirects": false,
    "authorization": {"type": "Bearer", "credentials_file": "/run/secrets/relay_metrics_key"},
    "static_configs": [{"targets": ["live.bmux.dev:443"]}]
  }]
}
