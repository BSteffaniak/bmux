{
  "description": "Repeated pane focus changes should not fall back to full-surface rendering or churn graphics deletes.",
  "ignore_actions": ["new-session", "split-pane", "send-keys", "wait-for"],
  "max_total_elapsed_ms": 15000,
  "max_step_elapsed_ms": 5000,
  "render": {
    "max_full_surface_fallbacks": 0,
    "max_rows_emitted": 400,
    "max_cells_emitted": 60000,
    "max_frame_bytes": 150000,
    "max_terminal_graphic_deletes": 0
  },
  "perf": {
    "require_events": false,
    "max_malformed_payloads": 0,
    "max_dropped_events_reported": 0,
    "max_render_p95_ms": 16,
    "max_drain_ipc_p95_ms": 20
  }
}
