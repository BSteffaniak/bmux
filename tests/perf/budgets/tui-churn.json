{
  "description": "Terminal content churn should stay partial-frame and avoid graphics churn.",
  "ignore_actions": ["new-session", "send-keys"],
  "max_total_elapsed_ms": 12000,
  "max_step_elapsed_ms": 9000,
  "render": {
    "max_full_frame_frames": 0,
    "max_full_surface_fallbacks": 0,
    "max_rows_emitted": 120,
    "max_cells_emitted": 12000,
    "max_frame_bytes": 100000,
    "max_terminal_graphic_deletes": 0
  },
  "perf": {
    "require_events": false,
    "max_malformed_payloads": 0,
    "max_dropped_events_reported": 0,
    "max_render_p95_ms": 16,
    "max_drain_ipc_p95_ms": 20
  }
}
