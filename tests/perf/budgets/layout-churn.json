{
  "description": "Layout churn may redraw, but should remain bounded and avoid full-surface fallbacks.",
  "ignore_actions": ["new-session", "send-keys", "wait-for"],
  "max_total_elapsed_ms": 15000,
  "max_step_elapsed_ms": 5000,
  "render": {
    "max_full_surface_fallbacks": 0,
    "max_rows_emitted": 600,
    "max_row_segments_emitted": 60,
    "max_cells_emitted": 90000,
    "max_frame_bytes": 220000,
    "max_terminal_graphic_transmits": 0,
    "max_terminal_graphic_places": 0,
    "max_terminal_graphic_deletes": 0,
    "max_terminal_graphic_bytes": 0
  },
  "perf": {
    "require_events": false,
    "max_malformed_payloads": 0,
    "max_dropped_events_reported": 0,
    "max_render_p95_ms": 16,
    "max_drain_ipc_p95_ms": 20,
    "max_render_frames": 10,
    "max_overrender_flagged_frames": 10,
    "max_full_frame_fallback_flagged_frames": 8,
    "max_large_partial_frame_frames": 2,
    "max_slow_terminal_write_per_kib_frames": 0,
    "max_extension_cache_misses": 25,
    "max_extension_imperative_calls": 0,
    "max_extension_imperative_or_cache_miss_frames": 10,
    "max_terminal_graphic_transmits": 0,
    "max_terminal_graphic_places": 0,
    "max_terminal_graphic_deletes": 0,
    "max_terminal_graphic_bytes": 0
  }
}
