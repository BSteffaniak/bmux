plugin bmux.application_resurrection version 1;

capability RESURRECTION_HOST = bmux.application_resurrection.host;

@capability(RESURRECTION_HOST)
interface resurrection-host-v1 {
    record host-status {
        protocol: string,
        available: bool,
        reason: string?,
    }
    query status() -> host-status;
}

@capability(RESURRECTION_HOST)
interface resurrection-launch-v1 {
    variant host-error {
        failed { message: string },
    }
    command prepare(key: string, restored: bool, shell: bool, replay: bool) -> result<string, host-error>;
    command bind(key: string, endpoint: string, pid: u32) -> result<bool, host-error>;
    command boundary(key: string, endpoint: string, prompt: bool) -> result<bool, host-error>;
    command close(key: string, endpoint: string) -> result<bool, host-error>;
}

@capability(RESURRECTION_HOST)
interface resurrection-launch-v2 {
    record prepared-launch {
        endpoint: string,
        invocation: string,
    }
    command prepare(key: string, restored: bool, shell: bool, replay: bool, expected-invocation: string?)
        -> result<prepared-launch, resurrection-launch-v1.host-error>;
}
