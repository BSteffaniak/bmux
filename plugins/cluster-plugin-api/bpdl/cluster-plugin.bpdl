// Stable typed contract for the bmux cluster plugin.
//
// This first schema models the plugin's existing inventory, health,
// orchestration, pane mutation, and connection-event services. Native
// federation interfaces are added as their implementation phases begin;
// runtime managers and transport policy remain in the implementation crate.

plugin bmux.cluster version 1;

capability CLUSTER_READ = bmux.server_clusters.read;
capability CLUSTER_WRITE = bmux.server_clusters.write;

interface cluster-types {
    enum cluster-host-state {
        ready,
        degraded,
    }

    enum cluster-consensus-role {
        voter,
        observer-edge,
    }

    record cluster-node-capabilities {
        consensus_role: cluster-consensus-role,
        worker: bool,
        ingress: bool,
    }

    record cluster-identity {
        cluster_id: string?,
        node_id: string,
        public_key: string,
        capabilities: cluster-node-capabilities?,
    }

    enum cluster-member-state {
        active,
        left,
    }

    record cluster-member {
        cluster_id: string,
        node_id: string,
        public_key: string,
        endpoint: string?,
        capabilities: cluster-node-capabilities,
        joined_at_unix_ms: u64,
        updated_at_unix_ms: u64,
        state: cluster-member-state,
    }

    record cluster-member-list {
        cluster_id: string?,
        members: list<cluster-member>,
    }

    record enrollment-token-result {
        token: string,
        expires_at_unix_ms: u64,
    }

    record cluster-join-result {
        identity: cluster-identity,
        member: cluster-member,
        members: list<cluster-member>,
    }

    record cluster-leave-request {
        leave_id: string,
        issuer_endpoint: string?,
        cluster_id: string,
        node_id: string,
        signature: bytes,
    }

    record cluster-leave-result {
        leave_id: string,
        node_id: string,
        left: bool,
    }

    record cluster-host-status {
        cluster: string,
        target: string,
        state: cluster-host-state,
        reason: string?,
    }

    record cluster-launch-status {
        target: string,
        state: cluster-host-state,
        reason: string?,
        pane_id: string?,
    }

    record cluster-list-result {
        clusters: map<string, list<string>>,
    }

    record cluster-status-result {
        statuses: list<cluster-host-status>,
    }

    record cluster-up-result {
        session_id: string,
        statuses: list<cluster-launch-status>,
    }

    record cluster-pane-mutation-result {
        target: string,
        old_pane_id: string?,
        old_name: string?,
        new_pane_id: string,
        session_id: string,
    }

    enum cluster-connection-state {
        @default connecting,
        ready,
        degraded,
        retrying,
        failed,
    }

    record cluster-connection-event {
        ts_unix_ms: u64,
        pane_id: string?,
        cluster: string?,
        target: string?,
        source: string?,
        state: cluster-connection-state,
        message: string,
    }

    record cluster-connection-event-list {
        events: list<cluster-connection-event>,
    }
}

@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-query {
    query identity() -> cluster-types.cluster-identity;
    query list_clusters() -> cluster-types.cluster-list-result;
    query status(selector: string?, doctor: bool?) -> cluster-types.cluster-status-result;
    query members() -> cluster-types.cluster-member-list;
}

@capability(CLUSTER_WRITE)
@interface-version(1)
interface cluster-command {
    command init() -> cluster-types.cluster-identity;
    command enrollment_token_create(request_id: string, endpoint: string, ttl_ms: u64?, capabilities: cluster-types.cluster-node-capabilities?) -> cluster-types.enrollment-token-result;
    command join(token: string, issuer: string, enrollment_result: cluster-types.cluster-join-result) -> cluster-types.cluster-join-result;
    command redeem_enrollment(token: string, node_id: string, public_key: string, endpoint: string?) -> cluster-types.cluster-join-result;
    command leave_prepare() -> cluster-types.cluster-leave-request;
    command leave(leave_id: string) -> cluster-types.cluster-leave-result;
    command accept_leave(leave_id: string, cluster_id: string, node_id: string, signature: bytes) -> cluster-types.cluster-leave-result;
    command up(cluster: string, hosts: list<string>) -> cluster-types.cluster-up-result;
    command pane_new(host: string, name: string?) -> cluster-types.cluster-pane-mutation-result;
    command pane_retry(pane: string?) -> cluster-types.cluster-pane-mutation-result;
    command pane_move(pane: string?, host: string) -> cluster-types.cluster-pane-mutation-result;
}

@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-connection-events {
    query list() -> cluster-types.cluster-connection-event-list;
}
