// Stable typed contract for the bmux cluster plugin.
//
// This first schema models the plugin's existing inventory, health,
// orchestration, pane mutation, and connection-event services. Native
// federation interfaces are added as their implementation phases begin;
// runtime managers and transport policy remain in the implementation crate.

plugin bmux.cluster version 1;

capability CLUSTER_READ = bmux.server_clusters.read;
capability CLUSTER_WRITE = bmux.server_clusters.write;
capability CLUSTER_AUTH = bmux.server_clusters.auth;

interface cluster-types {
    enum cluster-host-state {
        ready,
        degraded,
    }

    enum cluster-consensus-role {
        voter,
        observer-edge,
    }

    record cluster-node-capabilities {
        consensus_role: cluster-consensus-role,
        worker: bool,
        ingress: bool,
    }

    record cluster-protocol-offer {
        wire_epoch: u16,
        peer_revision_min: u32,
        peer_revision_max: u32,
        schema_version_min: u32,
        schema_version_max: u32,
        plugin_version: string,
        features: list<string>,
    }

    record cluster-negotiated-protocol {
        wire_epoch: u16,
        peer_revision: u32,
        schema_version: u32,
        local_plugin_version: string,
        remote_plugin_version: string,
        features: list<string>,
    }

    record cluster-identity {
        cluster_id: string?,
        node_id: string,
        public_key: string,
        capabilities: cluster-node-capabilities?,
        protocol: cluster-protocol-offer,
    }

    record workspace-id {
        value: uuid,
    }

    record logical-window-id {
        value: uuid,
    }

    record logical-pane-id {
        value: uuid,
    }

    record execution-id {
        value: uuid,
    }

    record command-id {
        value: uuid,
    }

    record promotion-id {
        value: uuid,
    }

    enum pane-restart-policy {
        manual,
        never,
        on-worker-loss,
    }

    enum pane-availability {
        pending,
        ready,
        suspect,
        unavailable,
        reconciling,
        replacing,
        exited,
        failed,
        quarantined,
    }

    record placement-label {
        key: string,
        value: string,
    }

    record placement-intent {
        explicit_node_id: string?,
        required_labels: list<placement-label>,
        preferred_labels: list<placement-label>,
    }

    record execution-assignment {
        node_id: string,
        generation: u64,
        execution_id: execution-id,
    }

    record workspace-record {
        workspace_id: workspace-id,
        name: string?,
        revision: u64,
    }

    record logical-window-record {
        window_id: logical-window-id,
        workspace_id: workspace-id,
        name: string?,
        layout_schema_version: u32,
        layout: bytes,
        revision: u64,
    }

    record logical-pane-record {
        pane_id: logical-pane-id,
        workspace_id: workspace-id,
        window_id: logical-window-id,
        name: string?,
        restart_policy: pane-restart-policy,
        placement: placement-intent,
        availability: pane-availability,
        availability_reason: string?,
        execution: execution-assignment?,
        revision: u64,
    }

    variant control-command-request {
        upsert-member { member: cluster-member },
        set-member-state { node_id: string, expected_credential_serial: string, state: cluster-member-state },
        create-workspace { workspace_id: workspace-id, name: string? },
        rename-workspace { workspace_id: workspace-id, expected_revision: u64, name: string? },
        put-window { window: logical-window-record, expected_workspace_revision: u64 },
        remove-window { window_id: logical-window-id, expected_workspace_revision: u64 },
        put-pane { pane: logical-pane-record, expected_workspace_revision: u64 },
        remove-pane { pane_id: logical-pane-id, expected_revision: u64, expected_generation: u64? },
        assign-execution { pane_id: logical-pane-id, expected_revision: u64, expected_generation: u64, assignment: execution-assignment },
        set-pane-availability { pane_id: logical-pane-id, expected_revision: u64, assignment: execution-assignment, availability: pane-availability, reason: string? },
        complete-workflow { original_command_id: command-id, response: bytes },
        prune-dedup { completed_before_unix_ms: u64 },
    }

    record control-command {
        schema_version: u16,
        principal_id: string,
        command_id: command-id,
        issued_at_unix_ms: u64,
        request: control-command-request,
    }

    enum control-resource-kind {
        member,
        workspace,
        window,
        pane,
        execution,
        workflow,
    }

    variant control-command-error {
        command-id-conflict,
        not-found { resource: control-resource-kind, id: string },
        already-exists { resource: control-resource-kind, id: string },
        revision-conflict { expected: u64, current: u64 },
        generation-conflict { expected: u64, current: u64 },
        invalid-reference { resource: control-resource-kind, id: string },
        invalid-transition { reason: string },
        member-inactive { node_id: string },
        incompatible-schema { supported: u16, received: u16 },
        quorum-required,
        not-leader { leader_node_id: string? },
    }

    enum control-workflow-status {
        complete,
        pending,
    }

    variant control-command-result {
        accepted { payload: bytes },
        rejected { error: control-command-error },
    }

    record control-response {
        schema_version: u16,
        command_id: command-id,
        control_revision: u64,
        workflow_status: control-workflow-status,
        result: control-command-result,
    }

    enum cluster-member-state {
        active,
        revoked,
        left,
    }

    record cluster-member {
        cluster_id: string,
        node_id: string,
        public_key: string,
        endpoint: string?,
        capabilities: cluster-node-capabilities,
        credential_serial: string,
        credential_issuer_node_id: string,
        credential_issuer_public_key: string,
        credential_issued_at_unix_ms: u64,
        credential_expires_at_unix_ms: u64,
        credential_signature: string,
        negotiated_protocol: cluster-negotiated-protocol,
        joined_at_unix_ms: u64,
        updated_at_unix_ms: u64,
        state: cluster-member-state,
    }

    record cluster-member-list {
        cluster_id: string?,
        members: list<cluster-member>,
    }

    record enrollment-token-result {
        token: string,
        expires_at_unix_ms: u64,
    }

    enum enrollment-state {
        active,
        consumed,
        revoked,
        expired,
    }

    record enrollment-status {
        enrollment_id: string,
        request_id: string,
        expires_at_unix_ms: u64,
        state: enrollment-state,
        consumed_by: string?,
    }

    record enrollment-list {
        enrollments: list<enrollment-status>,
    }

    record enrollment-revocation-result {
        enrollment_id: string,
        revoked: bool,
    }

    record member-credential-result {
        member: cluster-member,
    }

    enum member-liveness-state {
        local,
        reachable,
        unreachable,
        unchecked,
        inactive,
        incompatible,
        untrusted,
    }

    record member-status {
        member: cluster-member,
        liveness: member-liveness-state,
        reachable: bool?,
        compatible: bool,
        trusted: bool,
        authenticated_at_unix_ms: u64?,
        observed_at_unix_ms: u64,
        reason: string?,
    }

    record membership-status {
        identity: cluster-identity,
        members: list<member-status>,
    }

    record credential-rotation-request {
        node_id: string,
        current_serial: string,
        issuer_endpoint: string?,
        nonce: string,
        issued_at_unix_ms: u64,
        expires_at_unix_ms: u64,
        signature: string,
    }

    record cluster-join-result {
        identity: cluster-identity,
        member: cluster-member,
        members: list<cluster-member>,
    }

    record peer-auth-challenge {
        protocol_version: u16,
        cluster_id: string,
        verifier_node_id: string,
        verifier_credential_serial: string,
        audience_node_id: string,
        nonce: string,
        issued_at_unix_ms: u64,
        expires_at_unix_ms: u64,
        signature: string,
    }

    record peer-auth-proof {
        challenge: peer-auth-challenge,
        claimant_node_id: string,
        claimant_credential_serial: string,
        claimant_signature: string,
    }

    record authenticated-peer {
        cluster_id: string,
        node_id: string,
        capabilities: cluster-node-capabilities,
        credential_serial: string,
        authenticated_at_unix_ms: u64,
    }

    record cluster-leave-request {
        leave_id: string,
        issuer_endpoint: string?,
        cluster_id: string,
        node_id: string,
        signature: bytes,
    }

    record cluster-leave-result {
        leave_id: string,
        node_id: string,
        left: bool,
    }

    record cluster-host-status {
        cluster: string,
        target: string,
        state: cluster-host-state,
        reason: string?,
    }

    record cluster-launch-status {
        target: string,
        state: cluster-host-state,
        reason: string?,
        pane_id: string?,
    }

    record cluster-list-result {
        clusters: map<string, list<string>>,
    }

    record cluster-status-result {
        statuses: list<cluster-host-status>,
    }

    record cluster-up-result {
        session_id: string,
        statuses: list<cluster-launch-status>,
    }

    record cluster-pane-mutation-result {
        target: string,
        old_pane_id: string?,
        old_name: string?,
        new_pane_id: string,
        session_id: string,
    }

    enum cluster-connection-state {
        @default connecting,
        ready,
        degraded,
        retrying,
        failed,
    }

    record cluster-connection-event {
        ts_unix_ms: u64,
        pane_id: string?,
        cluster: string?,
        target: string?,
        source: string?,
        state: cluster-connection-state,
        message: string,
    }

    record cluster-connection-event-list {
        events: list<cluster-connection-event>,
    }
}

@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-query {
    query identity() -> cluster-types.cluster-identity;
    query list_clusters() -> cluster-types.cluster-list-result;
    query status(selector: string?, doctor: bool?) -> cluster-types.cluster-status-result;
    query members() -> cluster-types.cluster-member-list;
    query membership_status() -> cluster-types.membership-status;
    query enrollments() -> cluster-types.enrollment-list;
}

@capability(CLUSTER_WRITE)
@interface-version(1)
interface cluster-command {
    command init() -> cluster-types.cluster-identity;
    command enrollment_token_create(request_id: string, endpoint: string, ttl_ms: u64?, capabilities: cluster-types.cluster-node-capabilities?) -> cluster-types.enrollment-token-result;
    command enrollment_revoke(enrollment_id: string) -> cluster-types.enrollment-revocation-result;
    command credential_rotate_prepare() -> cluster-types.credential-rotation-request;
    command credential_rotate_accept(request: cluster-types.credential-rotation-request) -> cluster-types.member-credential-result;
    command credential_rotate_commit(member: cluster-types.cluster-member) -> cluster-types.member-credential-result;
    command member_revoke(node_id: string) -> cluster-types.member-credential-result;
    command join(token: string, issuer: string, enrollment_result: cluster-types.cluster-join-result) -> cluster-types.cluster-join-result;
    command redeem_enrollment(token: string, node_id: string, public_key: string, endpoint: string?, protocol: cluster-types.cluster-protocol-offer, possession_signature: bytes) -> cluster-types.cluster-join-result;
    command leave_prepare() -> cluster-types.cluster-leave-request;
    command leave(leave_id: string) -> cluster-types.cluster-leave-result;
    command accept_leave(leave_id: string, cluster_id: string, node_id: string, signature: bytes) -> cluster-types.cluster-leave-result;
    command up(cluster: string, hosts: list<string>) -> cluster-types.cluster-up-result;
    command pane_new(host: string, name: string?) -> cluster-types.cluster-pane-mutation-result;
    command pane_retry(pane: string?) -> cluster-types.cluster-pane-mutation-result;
    command pane_move(pane: string?, host: string) -> cluster-types.cluster-pane-mutation-result;
}

@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-peer-auth {
    command challenge(claimant_node_id: string) -> cluster-types.peer-auth-challenge;
    command prove(challenge: cluster-types.peer-auth-challenge) -> cluster-types.peer-auth-proof;
    command authenticate(proof: cluster-types.peer-auth-proof) -> cluster-types.authenticated-peer;
}

@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-connection-events {
    query list() -> cluster-types.cluster-connection-event-list;
}
