// Stable typed contract for the bmux cluster plugin.
//
// This first schema models the plugin's existing inventory, health,
// orchestration, pane mutation, and connection-event services. Native
// federation interfaces are added as their implementation phases begin;
// runtime managers and transport policy remain in the implementation crate.

plugin bmux.cluster version 1;

capability CLUSTER_READ = bmux.server_clusters.read;
capability CLUSTER_WRITE = bmux.server_clusters.write;
capability CLUSTER_AUTH = bmux.server_clusters.auth;

// Bootstrap proof is independent of node connectivity credentials; mutation
// additionally requires committed feature/schema activation.
interface cluster-principal-bootstrap-types {
    record bootstrap-statement {
        schema-version: u16,
        cluster-id: string,
        membership-term: u64,
        membership-leader-id: string,
        membership-log-index: u64,
        principal-id: uuid,
        principal-public-key: string,
        command-id: cluster-types.command-id,
    }

    record voter-approval {
        node-id: string,
        signature: bytes,
    }

    record bootstrap-proof {
        statement: bootstrap-statement,
        principal-signature: bytes,
        voter-approvals: list<voter-approval>,
    }
}

// Supported capability evidence is distinct from active negotiated protocol.
interface cluster-capability-types {
    record capability-report {
        report-version: u16,
        cluster-id: string,
        node-id: string,
        credential-serial: string,
        membership-term: u64,
        membership-leader-id: string,
        membership-log-index: u64,
        expected-report-revision: u64,
        command-id: cluster-types.command-id,
        schema-min: u32,
        schema-max: u32,
        features: list<string>,
        signature: bytes,
    }
}

interface cluster-types {
    enum cluster-host-state {
        ready,
        degraded,
    }

    enum cluster-consensus-role {
        voter,
        observer-edge,
    }

    record cluster-node-capabilities {
        consensus_role: cluster-consensus-role,
        worker: bool,
        ingress: bool,
    }

    record cluster-protocol-offer {
        wire_epoch: u16,
        peer_revision_min: u32,
        peer_revision_max: u32,
        schema_version_min: u32,
        schema_version_max: u32,
        plugin_version: string,
        features: list<string>,
    }

    record cluster-negotiated-protocol {
        wire_epoch: u16,
        peer_revision: u32,
        schema_version: u32,
        local_plugin_version: string,
        remote_plugin_version: string,
        features: list<string>,
    }

    record cluster-identity {
        cluster_id: string?,
        node_id: string,
        public_key: string,
        capabilities: cluster-node-capabilities?,
        protocol: cluster-protocol-offer,
    }

    record workspace-id {
        value: uuid,
    }

    record logical-tab-id {
        value: uuid,
    }

    record logical-pane-id {
        value: uuid,
    }

    record execution-id {
        value: uuid,
    }

    record command-id {
        value: uuid,
    }

    record promotion-id {
        value: uuid,
    }

    enum pane-restart-policy {
        manual,
        never,
        on-worker-loss,
    }

    enum pane-availability {
        pending,
        ready,
        suspect,
        unavailable,
        reconciling,
        replacing,
        exited,
        failed,
        quarantined,
    }

    record placement-label {
        key: string,
        value: string,
    }

    record placement-intent {
        explicit_node_id: string?,
        required_labels: list<placement-label>,
        preferred_labels: list<placement-label>,
    }

    enum worker-operation-class {
        interactive,
        lifecycle,
        // Following an execution's screen (frames pushed to the observing connection).
        observe,
    }

    record worker-authority {
        cluster_id: string,
        workspace_id: workspace-id,
        pane_id: logical-pane-id,
        execution_id: execution-id,
        generation: u64,
        control_term: u64,
        lease_sequence: u64,
        operation_class: worker-operation-class,
        principal_id: string,
        issuer_node_id: string,
        audience_node_id: string,
        lease_id: uuid,
        lease_issued_at_unix_ms: u64,
        lease_duration_ms: u64,
        lease_signature: bytes,
    }

    record worker-launch-spec {
        program: string?,
        args: list<string>,
        cwd: string?,
        env: list<placement-label>,
        cols: u16,
        rows: u16,
    }

    record worker-adoption-spec {
        local_session_id: uuid,
        local_pane_id: uuid,
    }

    enum worker-execution-state {
        launching,
        ready,
        exited,
        unavailable,
        quarantined,
        closed,
    }

    record worker-execution {
        authority: worker-authority,
        local_session_id: uuid,
        local_pane_id: uuid,
        state: worker-execution-state,
        exit_code: i32?,
    }

    record worker-execution-list {
        executions: list<worker-execution>,
    }

    record worker-registry-stats {
        execution_count: u32,
    }

    record worker-mutation-ack {
        execution_id: execution-id,
        generation: u64,
        applied: bool,
    }

    // One generation of one execution.
    record execution-ref {
        execution_id: execution-id,
        generation: u64,
    }

    // Where to follow an execution's screen: its worker, and a lease authorizing the caller to
    // observe it there.
    record worker-route {
        execution_id: execution-id,
        generation: u64,
        node_id: string,
        endpoint: string,
        authority: worker-authority,
    }

    // An execution a connection now observes, and the worker-local pane its pushed frames name.
    record observed-execution {
        execution_id: execution-id,
        generation: u64,
        session_id: uuid,
        pane_id: uuid,
    }

    variant worker-service-error {
        not-found { execution_id: execution-id },
        command-conflict,
        stale-generation { expected: u64, received: u64 },
        stale-term { expected_minimum: u64, received: u64 },
        lease-expired,
        authority-mismatch,
        cursor-gap { retained_start: u64, requested: u64 },
        invalid-request { reason: string },
        local-runtime { reason: string },
        unavailable { reason: string },
    }

    enum worker-signal {
        interrupt,
        terminate,
        kill,
        hangup,
    }

    variant worker-launch-result {
        ready { execution: worker-execution },
        pending { execution: worker-execution },
    }

    variant worker-query-result {
        found { execution: worker-execution },
        missing,
    }

    record attach-action-request {
        workspace_id: workspace-id,
        command_id: command-id,
        principal_id: string,
        action: string,
        arguments: list<string>,
    }

    record attach-resize-request {
        workspace_id: workspace-id,
        command_id: command-id,
        execution_id: execution-id,
        generation: u64,
        principal_id: string,
        cols: u16,
        rows: u16,
    }

    record execution-assignment {
        node_id: string,
        generation: u64,
        execution_id: execution-id,
    }

    record workspace-record {
        workspace_id: workspace-id,
        name: string?,
        revision: u64,
    }

    record logical-tab-record {
        tab_id: logical-tab-id,
        workspace_id: workspace-id,
        name: string?,
        layout_schema_version: u32,
        layout: bytes,
        revision: u64,
    }

    record attach-layout-rect {
        pane_id: logical-pane-id,
        x: u16,
        y: u16,
        width: u16,
        height: u16,
    }

    record attach-layout {
        workspace_id: workspace-id,
        tab_id: logical-tab-id,
        control_revision: u64,
        panes: list<logical-pane-record>,
        rects: list<attach-layout-rect>,
    }

    record feature-floor-state {
        control_revision: u64,
        read_schema_floor: u16,
        write_schema_floor: u16,
        activated_features: list<string>,
    }

    record logical-pane-record {
        pane_id: logical-pane-id,
        workspace_id: workspace-id,
        tab_id: logical-tab-id,
        name: string?,
        restart_policy: pane-restart-policy,
        placement: placement-intent,
        availability: pane-availability,
        availability_reason: string?,
        execution: execution-assignment?,
        revision: u64,
    }

    variant control-command-request {
        upsert-member { member: cluster-member },
        set-member-state { node_id: string, expected_credential_serial: string, state: cluster-member-state },
        create-workspace { workspace_id: workspace-id, name: string? },
        rename-workspace { workspace_id: workspace-id, expected_revision: u64, name: string? },
        put-tab { tab: logical-tab-record, expected_workspace_revision: u64 },
        remove-tab { tab_id: logical-tab-id, expected_workspace_revision: u64 },
        put-pane { pane: logical-pane-record, expected_workspace_revision: u64 },
        remove-pane { pane_id: logical-pane-id, expected_revision: u64, expected_generation: u64? },
        assign-execution { pane_id: logical-pane-id, expected_revision: u64, expected_generation: u64, assignment: execution-assignment, launch_spec: worker-launch-spec? },
        set-pane-availability { pane_id: logical-pane-id, expected_revision: u64, assignment: execution-assignment, availability: pane-availability, reason: string? },
        complete-workflow { original_command_id: command-id, response: bytes },
        prune-dedup { completed_before_unix_ms: u64 },
    }

    record control-command {
        schema_version: u16,
        principal_id: string,
        command_id: command-id,
        issued_at_unix_ms: u64,
        request: control-command-request,
    }

    enum control-resource-kind {
        member,
        workspace,
        tab,
        pane,
        execution,
        workflow,
    }

    variant control-command-error {
        command-id-conflict,
        not-found { resource: control-resource-kind, id: string },
        already-exists { resource: control-resource-kind, id: string },
        revision-conflict { expected: u64, current: u64 },
        generation-conflict { expected: u64, current: u64 },
        invalid-reference { resource: control-resource-kind, id: string },
        invalid-transition { reason: string },
        member-inactive { node_id: string },
        incompatible-schema { supported: u16, received: u16 },
        quorum-required,
        not-leader { leader_node_id: string? },
    }

    record pending-workflow {
        principal_id: string,
        control_command: control-command,
    }

    record control-state-view {
        schema_version: u16,
        cluster_id: string,
        revision: u64,
        membership_epoch: string?,
        members: list<cluster-member>,
        workspaces: list<workspace-record>,
        tabs: list<logical-tab-record>,
        panes: list<logical-pane-record>,
        pending_workflows: list<pending-workflow>,
        consistency: control-read-consistency,
    }

    enum control-read-consistency {
        linearizable,
        stale,
    }

    variant control-service-error {
        not-initialized,
        runtime-unavailable { reason: string },
        not-leader { leader_node_id: string?, leader_endpoint: string? },
        quorum-unavailable { reason: string },
        rejected { error: control-command-error },
        internal { reason: string },
    }

    enum control-workflow-status {
        complete,
        pending,
    }

    variant control-command-result {
        accepted { payload: bytes },
        rejected { error: control-command-error },
    }

    record control-response {
        schema_version: u16,
        command_id: command-id,
        control_revision: u64,
        workflow_status: control-workflow-status,
        result: control-command-result,
    }

    enum cluster-member-state {
        active,
        revoked,
        left,
    }

    record cluster-member {
        cluster_id: string,
        node_id: string,
        public_key: string,
        endpoint: string?,
        capabilities: cluster-node-capabilities,
        credential_serial: string,
        credential_issuer_node_id: string,
        credential_issuer_public_key: string,
        credential_issued_at_unix_ms: u64,
        credential_expires_at_unix_ms: u64,
        credential_signature: string,
        negotiated_protocol: cluster-negotiated-protocol,
        joined_at_unix_ms: u64,
        updated_at_unix_ms: u64,
        state: cluster-member-state,
    }

    record cluster-member-list {
        cluster_id: string?,
        membership_epoch: string?,
        members: list<cluster-member>,
    }

    record enrollment-token-result {
        token: string,
        expires_at_unix_ms: u64,
    }

    enum enrollment-state {
        active,
        consumed,
        revoked,
        expired,
    }

    record enrollment-status {
        enrollment_id: string,
        request_id: string,
        expires_at_unix_ms: u64,
        state: enrollment-state,
        consumed_by: string?,
    }

    record enrollment-list {
        enrollments: list<enrollment-status>,
    }

    record enrollment-revocation-result {
        enrollment_id: string,
        revoked: bool,
    }

    record member-credential-result {
        member: cluster-member,
    }

    enum member-liveness-state {
        local,
        reachable,
        unreachable,
        unchecked,
        inactive,
        incompatible,
        untrusted,
    }

    record member-status {
        member: cluster-member,
        liveness: member-liveness-state,
        reachable: bool?,
        compatible: bool,
        trusted: bool,
        authenticated_at_unix_ms: u64?,
        observed_at_unix_ms: u64,
        reason: string?,
    }

    record membership-status {
        identity: cluster-identity,
        members: list<member-status>,
    }

    record credential-rotation-request {
        node_id: string,
        current_serial: string,
        issuer_endpoint: string?,
        nonce: string,
        issued_at_unix_ms: u64,
        expires_at_unix_ms: u64,
        signature: string,
    }

    record cluster-join-result {
        voter_authorization: consensus-voter-change-authorization?,
        identity: cluster-identity,
        member: cluster-member,
        members: list<cluster-member>,
    }

    record peer-auth-challenge {
        protocol_version: u16,
        cluster_id: string,
        verifier_node_id: string,
        verifier_credential_serial: string,
        audience_node_id: string,
        nonce: string,
        issued_at_unix_ms: u64,
        expires_at_unix_ms: u64,
        signature: string,
    }

    record peer-auth-proof {
        challenge: peer-auth-challenge,
        claimant_node_id: string,
        claimant_credential_serial: string,
        claimant_signature: string,
    }

    record authenticated-peer {
        cluster_id: string,
        node_id: string,
        capabilities: cluster-node-capabilities,
        credential_serial: string,
        authenticated_at_unix_ms: u64,
    }

    enum consensus-voter-change-action {
        add,
        remove,
    }

    record consensus-voter-change-authorization {
        protocol_version: u16,
        membership_epoch: string,
        current_members_digest: bytes,
        proposed_members_digest: bytes,
        expires_at_unix_ms: u64,
        cluster_id: string,
        action: consensus-voter-change-action,
        target_node_id: string,
        actor_node_id: string,
        signature: bytes,
    }

    record cluster-leave-request {
        leave_id: string,
        issuer_endpoint: string?,
        cluster_id: string,
        node_id: string,
        signature: bytes,
    }

    record cluster-leave-result {
        leave_id: string,
        node_id: string,
        left: bool,
    }

    record cluster-host-status {
        cluster: string,
        target: string,
        state: cluster-host-state,
        reason: string?,
    }

    record cluster-launch-status {
        target: string,
        state: cluster-host-state,
        reason: string?,
        pane_id: string?,
    }

    record cluster-list-result {
        clusters: map<string, list<string>>,
    }

    record cluster-status-result {
        statuses: list<cluster-host-status>,
    }

    record cluster-up-result {
        session_id: string,
        statuses: list<cluster-launch-status>,
    }

    record cluster-pane-mutation-result {
        target: string,
        old_pane_id: string?,
        old_name: string?,
        new_pane_id: string,
        session_id: string,
    }

    enum cluster-connection-state {
        @default connecting,
        ready,
        degraded,
        retrying,
        failed,
    }

    record cluster-connection-event {
        ts_unix_ms: u64,
        pane_id: string?,
        cluster: string?,
        target: string?,
        source: string?,
        state: cluster-connection-state,
        message: string,
    }

    record raft-rpc-request {
        target_node_id: string,
        proof: peer-auth-proof,
        payload: bytes,
        signature: bytes,
    }

    record raft-decoder-proof {
        signature: bytes,
    }

    record raft-rpc-response {
        source_node_id: string,
        payload: bytes,
        error: string?,
    }

    record cluster-connection-event-list {
        events: list<cluster-connection-event>,
    }
}

// This version attests support for retained capability-publication commands and snapshots.
@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-raft-decoder {
    command probe(request: cluster-types.raft-rpc-request) -> result<cluster-types.raft-decoder-proof, string>;
}

@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-query {
    query identity() -> cluster-types.cluster-identity;
    query list_clusters() -> cluster-types.cluster-list-result;
    query status(selector: string?, doctor: bool?) -> cluster-types.cluster-status-result;
    query members() -> cluster-types.cluster-member-list;
    query membership_status() -> cluster-types.membership-status;
    query enrollments() -> cluster-types.enrollment-list;
}

@capability(CLUSTER_WRITE)
@interface-version(1)
interface cluster-command {
    command init(endpoint: string?) -> cluster-types.cluster-identity;
    command enrollment_token_create(request_id: string, endpoint: string, ttl_ms: u64?, capabilities: cluster-types.cluster-node-capabilities?) -> cluster-types.enrollment-token-result;
    command enrollment_revoke(enrollment_id: string) -> cluster-types.enrollment-revocation-result;
    command credential_rotate_prepare() -> cluster-types.credential-rotation-request;
    command credential_rotate_accept(request: cluster-types.credential-rotation-request) -> cluster-types.member-credential-result;
    command credential_rotate_commit(member: cluster-types.cluster-member) -> cluster-types.member-credential-result;
    command member_revoke(node_id: string) -> cluster-types.member-credential-result;
    // Internal recovery primitive: converge Raft voters to current signed membership.
    command consensus_reconcile() -> cluster-types.cluster-member-list;
    // Reconcile a prospective signed membership snapshot before publishing it.
    command consensus_reconcile_members(members: list<cluster-types.cluster-member>, authorization: cluster-types.consensus-voter-change-authorization) -> cluster-types.cluster-member-list;
    // Safely remove one current voter before publishing leave/revocation state.
    command consensus_remove_voter(authorization: cluster-types.consensus-voter-change-authorization) -> cluster-types.cluster-member-list;
    command join(token: string, issuer: string, enrollment_result: cluster-types.cluster-join-result) -> cluster-types.cluster-join-result;
    command redeem_enrollment(token: string, node_id: string, public_key: string, endpoint: string?, protocol: cluster-types.cluster-protocol-offer, possession_signature: bytes) -> cluster-types.cluster-join-result;
    command leave_prepare() -> cluster-types.cluster-leave-request;
    command leave(leave_id: string) -> cluster-types.cluster-leave-result;
    command accept_leave(leave_id: string, cluster_id: string, node_id: string, signature: bytes) -> cluster-types.cluster-leave-result;
    command up(cluster: string, hosts: list<string>) -> cluster-types.cluster-up-result;
    command pane_new(host: string, name: string?) -> cluster-types.cluster-pane-mutation-result;
    command pane_retry(pane: string?) -> cluster-types.cluster-pane-mutation-result;
    command pane_move(pane: string?, host: string) -> cluster-types.cluster-pane-mutation-result;
}

// Proof-bearing refresh is separate from generic membership metadata updates.
// Verification time is assigned by the authoritative runtime, not this contract.
@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-protocol-refresh {
    command submit(command_id: cluster-types.command-id, replacement: cluster-types.cluster-member, expected_serial: string, expected_revision: u64, node_signature: bytes) -> result<cluster-types.control-response, cluster-types.control-service-error>;
}

@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-principal-bootstrap {
    command submit(proof: cluster-principal-bootstrap-types.bootstrap-proof, expected_control_revision: u64) -> result<cluster-types.control-response, cluster-types.control-service-error>;
}

// Reports carry node proofs; the authority assigns credential verification time.
@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-capability-publication {
    command submit(reports: list<cluster-capability-types.capability-report>) -> result<cluster-types.control-response, cluster-types.control-service-error>;
}

@capability(CLUSTER_WRITE)
@interface-version(1)
interface cluster-control-command {
    command mutate(request: cluster-types.control-command) -> result<cluster-types.control-response, cluster-types.control-service-error>;
}

// Explicit bounded admission; never fall back to legacy mutation interfaces.
// Requires committed bounded-control-command-v1 activation. Canonical command
// bytes (including all fields) must not exceed 1,048,576 bytes.
@capability(CLUSTER_WRITE)
@interface-version(1)
interface cluster-bounded-control-command {
    // Protocol 1 guarantees the canonical 1 MiB admission limit and a
    // non-forwarding mutate-local operation. Unknown protocols are rejected.
    command forwarding-protocol() -> u16;
    // At most one forwarded hop. A missing local operation is an explicit
    // compatibility error, never permission to fall back to mutate or v1.
    command mutate(request: cluster-types.control-command) -> result<cluster-types.control-response, cluster-types.control-service-error>;
    // Same admission and authorization, but never forwards to another node.
    command mutate-local(request: cluster-types.control-command) -> result<cluster-types.control-response, cluster-types.control-service-error>;
}

@capability(CLUSTER_WRITE)
@interface-version(2)
interface cluster-control-command {
    command mutate(request: cluster-types.control-command) -> result<cluster-types.control-response, cluster-types.control-service-error>;
    command activate-feature(command_id: cluster-types.command-id, principal_id: string, issued_at_unix_ms: u64, expected_control_revision: u64, read_schema_floor: u16, write_schema_floor: u16, feature: string) -> result<cluster-types.control-response, cluster-types.control-service-error>;
}

@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-control-state {
    query read_linearizable() -> result<cluster-types.control-state-view, cluster-types.control-service-error>;
    query read_stale() -> result<cluster-types.control-state-view, cluster-types.control-service-error>;
}

@capability(CLUSTER_READ)
@interface-version(2)
interface cluster-control-state {
    query read_linearizable() -> result<cluster-types.control-state-view, cluster-types.control-service-error>;
    query read_stale() -> result<cluster-types.control-state-view, cluster-types.control-service-error>;
    query feature-floor() -> result<cluster-types.feature-floor-state, cluster-types.control-service-error>;
}

@capability(CLUSTER_WRITE)
@interface-version(1)
interface cluster-attach-command {
    command action(request: cluster-types.attach-action-request) -> result<cluster-types.control-response, cluster-types.control-service-error>;
    command input(workspace_id: cluster-types.workspace-id, command_id: cluster-types.command-id, execution_id: cluster-types.execution-id, generation: u64, principal_id: string, data: bytes) -> result<cluster-types.worker-mutation-ack, cluster-types.worker-service-error>;
    command resize(request: cluster-types.attach-resize-request) -> result<cluster-types.worker-mutation-ack, cluster-types.worker-service-error>;
}

@capability(CLUSTER_READ)
// v2: `snapshot` and `output` gave way to `routes` (observe leases; frames are pushed).
@interface-version(2)
interface cluster-attach-state {
    query layout(workspace_id: cluster-types.workspace-id, tab_id: cluster-types.logical-tab-id?, columns: u16, rows: u16) -> result<cluster-types.attach-layout, cluster-types.control-service-error>;
    // Where to follow each execution's screen: its worker's endpoint and an observe lease.
    query routes(workspace_id: cluster-types.workspace-id, principal_id: string, executions: list<cluster-types.execution-ref>) -> result<list<cluster-types.worker-route>, cluster-types.worker-service-error>;
}

@capability(CLUSTER_WRITE)
// v2: leases gained the `observe` class and executions lost their output cursors.
@interface-version(2)
interface cluster-worker-command {
    command launch(command_id: cluster-types.command-id, authority: cluster-types.worker-authority, spec: cluster-types.worker-launch-spec) -> result<cluster-types.worker-launch-result, cluster-types.worker-service-error>;
    command adopt(command_id: cluster-types.command-id, authority: cluster-types.worker-authority, spec: cluster-types.worker-adoption-spec) -> result<cluster-types.worker-launch-result, cluster-types.worker-service-error>;
    command input(command_id: cluster-types.command-id, authority: cluster-types.worker-authority, data: bytes) -> result<cluster-types.worker-mutation-ack, cluster-types.worker-service-error>;
    command resize(command_id: cluster-types.command-id, authority: cluster-types.worker-authority, cols: u16, rows: u16) -> result<cluster-types.worker-mutation-ack, cluster-types.worker-service-error>;
    command signal(command_id: cluster-types.command-id, authority: cluster-types.worker-authority, signal: cluster-types.worker-signal) -> result<cluster-types.worker-mutation-ack, cluster-types.worker-service-error>;
    command restart(command_id: cluster-types.command-id, authority: cluster-types.worker-authority, spec: cluster-types.worker-launch-spec) -> result<cluster-types.worker-launch-result, cluster-types.worker-service-error>;
    command close(command_id: cluster-types.command-id, authority: cluster-types.worker-authority) -> result<cluster-types.worker-mutation-ack, cluster-types.worker-service-error>;
    command reconcile(executions: list<cluster-types.worker-execution>) -> result<cluster-types.worker-registry-stats, cluster-types.worker-service-error>;
}

@capability(CLUSTER_READ)
// v2: `output` and `snapshot` are gone; workers push frames (`cluster-worker-stream`).
@interface-version(2)
interface cluster-worker-state {
    query get(execution_id: cluster-types.execution-id) -> result<cluster-types.worker-query-result, cluster-types.worker-service-error>;
    query inventory() -> cluster-types.worker-execution-list;
}

// Push the caller's connection the control revision whenever the cluster's control state
// advances (CONTROL_APPLIED_KIND), so it reads what changed then instead of polling. Returns
// the revision applied now; `enabled: false` stops.
@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-control-watch {
    query watch(enabled: bool) -> result<u64, cluster-types.control-service-error>;
}

// Executions' screens pushed to the observing connection as frames (the pane runtime's frame
// push), each authorized by an observe lease the ingress signed. Observing a new set replaces
// the previous one; an empty set stops.
@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-worker-stream {
    query observe(authorities: list<cluster-types.worker-authority>, max_history_lines: u32) -> result<list<cluster-types.observed-execution>, cluster-types.worker-service-error>;
}

// Owned-engine staging contract. Not advertised until authenticated bounded
// staging and owned RPC negotiation are implemented together (ADR-0015).
interface cluster-consensus-transfer-types {
    // Canonical NodeId bytes are the full 32-byte signing public key, not UUIDs.
    record log-identity {
        term: u64,
        leader: bytes,
        index: u64,
    }
    record node-address {
        node: bytes,
        endpoint: string,
    }
    record voter-configuration {
        voters: list<bytes>,
    }
    record stored-membership {
        introduced-at: log-identity,
        configurations: list<voter-configuration>,
        nodes: list<node-address>,
    }
    record snapshot-descriptor {
        format-version: u16,
        cluster-id: string,
        snapshot-id: string,
        last-included: log-identity?,
        membership: stored-membership?,
        total-bytes: u64,
        checksum: bytes,
    }
    record entry-purpose {
        identity: log-identity,
        previous: log-identity?,
    }
    variant transfer-purpose {
        entry { value: entry-purpose },
        snapshot { value: snapshot-descriptor },
    }
    record transfer-header {
        cluster-id: string,
        sender: bytes,
        recipient: bytes,
        leader-term: u64,
        sender-incarnation: uuid,
        sequence: u64,
        purpose: transfer-purpose,
        total-bytes: u64,
        checksum: bytes,
    }
    // Signatures bind the operation, complete header, offset and chunk bytes.
    // Hash/signature lengths and encoded-envelope limits require validation.
    record transfer-proof {
        peer: cluster-types.peer-auth-proof,
        credential-serial: string,
        signature: bytes,
    }
    record transfer-request {
        header: transfer-header,
        proof: transfer-proof,
    }
    record chunk-request {
        header: transfer-header,
        offset: u64,
        data: bytes,
        proof: transfer-proof,
    }
    enum transfer-error {
        unauthorized,
        incompatible,
        stale-term,
        invalid-object,
        conflicting-identity,
        capacity-unavailable,
        unknown-transfer,
        cleanup-incomplete,
        storage-failure,
    }
    enum finish-outcome {
        sealed,
    }
    enum abort-outcome {
        no-staging-remains,
    }
    variant chunk-outcome {
        accepted { offset: u64 },
        expected-offset { offset: u64 },
    }
}

@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-consensus-transfer {
    command begin(request: cluster-consensus-transfer-types.transfer-request) -> result<u64, cluster-consensus-transfer-types.transfer-error>;
    command chunk(request: cluster-consensus-transfer-types.chunk-request) -> result<cluster-consensus-transfer-types.chunk-outcome, cluster-consensus-transfer-types.transfer-error>;
    command finish(request: cluster-consensus-transfer-types.transfer-request) -> result<cluster-consensus-transfer-types.finish-outcome, cluster-consensus-transfer-types.transfer-error>;
    command abort(request: cluster-consensus-transfer-types.transfer-request) -> result<cluster-consensus-transfer-types.abort-outcome, cluster-consensus-transfer-types.transfer-error>;
}

// Reserved owned-engine contract; not advertised until its provider and
// authenticated negotiation are implemented. Existing Raft RPC meanings stay unchanged.
interface cluster-consensus-rpc-types {
    record sealed-entry-reference {
        sender-incarnation: uuid,
        sequence: u64,
        identity: cluster-consensus-transfer-types.log-identity,
        total-bytes: u64,
        checksum: bytes,
    }
    variant append-entry {
        inline { canonical: bytes },
        staged { reference: sealed-entry-reference },
    }
    // The signature binds every field except itself, including operation and
    // request identity. Sender must equal the authenticated leader.
    record append-request {
        cluster-id: string,
        sender: bytes,
        recipient: bytes,
        request-id: uuid,
        term: u64,
        previous: cluster-consensus-transfer-types.log-identity?,
        entries: list<append-entry>,
        leader-commit: cluster-consensus-transfer-types.log-identity?,
        proof: cluster-consensus-transfer-types.transfer-proof,
    }
    variant append-outcome {
        durable { matched: cluster-consensus-transfer-types.log-identity? },
        conflict { next-index: u64 },
        missing-transfer { reference: sealed-entry-reference },
    }
    record append-response {
        request-id: uuid,
        source: bytes,
        term: u64,
        outcome: append-outcome,
        // Binds the complete signed request and response to the responder.
        signature: bytes,
    }
    enum rpc-error {
        unauthorized,
        incompatible,
        stale-term,
        invalid-request,
        capacity-unavailable,
        storage-failure,
        stopped,
        // Unclassified executor rejection; never implies a durable acknowledgment.
        execution-failed,
    }
}

@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-consensus-rpc {
    command vote(request: cluster-consensus-vote-types.vote-request) -> result<cluster-consensus-vote-types.vote-response, cluster-consensus-rpc-types.rpc-error>;
    // Durable means the log transaction committed, not application or quorum commit.
    command append(request: cluster-consensus-rpc-types.append-request) -> result<cluster-consensus-rpc-types.append-response, cluster-consensus-rpc-types.rpc-error>;
}

// Separate owned installation contract. Transfer v1 finish remains seal-only;
// neither legacy Raft RPC nor owned append meanings change. Not advertised.
interface cluster-consensus-snapshot-types {
    record install-request {
        request-id: uuid,
        // Complete immutable header; purpose MUST be snapshot. Both checksums
        // retain their distinct transfer-object and canonical-envelope meanings.
        reference: cluster-consensus-transfer-types.transfer-header,
        proof: cluster-consensus-transfer-types.transfer-proof,
    }
    enum install-rejection {
        stale-term,
        unknown-transfer,
        not-sealed,
        conflicting-reference,
        invalid-snapshot,
        incompatible,
        capacity-unavailable,
    }
    variant install-outcome {
        // Only an immediately committed installation can return this outcome.
        installed { boundary: cluster-consensus-transfer-types.log-identity },
        rejected { reason: install-rejection },
    }
    record install-response {
        request-id: uuid,
        source: bytes,
        term: u64,
        outcome: install-outcome,
        // Signs the exact signed request and all response fields except itself.
        signature: bytes,
    }
    enum install-error {
        unauthorized,
        incompatible,
        invalid-request,
        capacity-unavailable,
        storage-failure,
        stopped,
        execution-failed,
    }
}

@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-consensus-snapshot {
    // Requires explicit negotiation of snapshot v1, transfer v1 AND owned RPC
    // v1. No fallback to finish or legacy install-snapshot is permitted.
    command install(request: cluster-consensus-snapshot-types.install-request) -> result<cluster-consensus-snapshot-types.install-response, cluster-consensus-snapshot-types.install-error>;
}

interface cluster-consensus-vote-types {
    // Sender is the candidate. The request signature binds all fields except
    // itself, with a vote-specific operation/version domain separator.
    record vote-request {
        cluster-id: string,
        sender: bytes,
        recipient: bytes,
        request-id: uuid,
        term: u64,
        last-log: cluster-consensus-transfer-types.log-identity?,
        proof: cluster-consensus-transfer-types.transfer-proof,
    }
    // The responder signs the complete request binding and all response fields
    // except signature. A grant is published only after durable vote commit.
    record vote-response {
        request-id: uuid,
        source: bytes,
        term: u64,
        granted: bool,
        signature: bytes,
    }
}

@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-peer-auth {
    command challenge(claimant_node_id: string) -> cluster-types.peer-auth-challenge;
    command prove(challenge: cluster-types.peer-auth-challenge) -> cluster-types.peer-auth-proof;
    command authenticate(proof: cluster-types.peer-auth-proof) -> cluster-types.authenticated-peer;
}

// Member-only forwarding uses a fresh single-use peer proof and a signature
// bound to the read operation, receiver, and exact query payload.
@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-peer-read {
    command read_linearizable(request: cluster-types.raft-rpc-request) -> result<cluster-types.control-state-view, cluster-types.control-service-error>;
}

@capability(CLUSTER_AUTH)
@interface-version(1)
interface cluster-raft-rpc {
    command append_entries(request: cluster-types.raft-rpc-request) -> cluster-types.raft-rpc-response;
    command install_snapshot(request: cluster-types.raft-rpc-request) -> cluster-types.raft-rpc-response;
    command vote(request: cluster-types.raft-rpc-request) -> cluster-types.raft-rpc-response;
}

// V2 receivers support retained capability-publication commands and snapshots.
// Senders must not fall back to v1 when this interface is unavailable.
@capability(CLUSTER_AUTH)
@interface-version(2)
interface cluster-raft-rpc {
    command append_entries(request: cluster-types.raft-rpc-request) -> cluster-types.raft-rpc-response;
    command install_snapshot(request: cluster-types.raft-rpc-request) -> cluster-types.raft-rpc-response;
    command vote(request: cluster-types.raft-rpc-request) -> cluster-types.raft-rpc-response;
}

@capability(CLUSTER_READ)
@interface-version(1)
interface cluster-connection-events {
    query list() -> cluster-types.cluster-connection-event-list;
}

/// What `bmux.cluster` provides to and requires from the host and other plugins.
world cluster {
    provide cluster-peer-read;
    provide cluster-raft-rpc@2;
    provide cluster-raft-decoder;
    provide cluster-capability-publication;
    provide cluster-protocol-refresh;
    provide cluster-principal-bootstrap;
    provide cluster-query;
    provide cluster-command;
    provide cluster-attach-command;
    provide cluster-attach-state;
    provide cluster-worker-command;
    provide cluster-worker-state;
    provide cluster-worker-stream;
    provide cluster-control-watch;
    provide cluster-peer-auth;
    provide cluster-connection-events;
    provide cluster-control-command@1;
    provide cluster-control-command@2;
    provide cluster-control-state@1;
    provide cluster-control-state@2;
    provide cluster-raft-rpc@1;
    provide cluster-bounded-control-command;
    require capability bmux.attach_runtime.read;
    require capability bmux.attach_runtime.write;
    require capability bmux.clients.read;
    require capability bmux.commands;
    require capability bmux.connections.invoke;
    require capability bmux.contexts.read;
    require capability bmux.contexts.write;
    require capability bmux.pane_runtime.read;
    require capability bmux.pane_runtime.write;
    require capability bmux.panes.write;
    require capability bmux.sessions.read;
    require capability bmux.sessions.write;
    require capability bmux.storage;
}
