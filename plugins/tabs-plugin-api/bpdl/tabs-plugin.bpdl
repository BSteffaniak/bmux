// Public, typed contract of the tabs plugin. Other plugins that
// depend on `bmux_tabs_plugin_api` import these interfaces rather
// than the tabs plugin implementation itself.
//
// Four interfaces:
// - `tabs-state` — read-only queries about panes and tabs.
// - `tabs-commands` — mutating operations on panes and tabs.
// - `tabs-events` — event stream of tab/pane lifecycle changes.
// - `tabs-list` — reactive state channel carrying the ordered
//   tab list for tab-bar rendering + positional navigation.

plugin bmux.tabs version 1;

capability TABS_READ = bmux.tabs.read;
capability TABS_WRITE = bmux.tabs.write;

@capability(TABS_WRITE)
interface tabs-placement-v1 {
    // Append a live tab to the destination arrangement before changing its
    // workspace attribute. Source references are retained, never destroyed.
    // Retrying an interrupted transfer is idempotent.
    command place-tab(context-id: uuid, workspace-id: uuid) -> result<unit, string>;
}

@capability(TABS_READ)
interface tabs-state {
    // A pane's current lifecycle status.
    variant pane-status {
        @default running,
        exited { exit-code: i32 },
    }

    // Snapshot of a single pane's state.
    record pane-state {
        id: uuid,
        session-id: uuid,
        focused: bool,
        zoomed: bool,
        name: string?,
        status: pane-status,
    }

    // Snapshot of a floating pane surface exposed through the tabs UX facade.
    record floating-pane-state {
        id: uuid,
        pane-id: uuid,
        session-id: uuid,
        anchor-pane-id: uuid?,
        context-id: uuid?,
        client-id: uuid?,
        x: u16,
        y: u16,
        w: u16,
        h: u16,
        z: i32,
        layer: string,
        scope: string,
        visible: bool,
    }

    // Snapshot of a tab. Tabs are a plugin-layered view over
    // sessions/contexts; the id is the underlying context id.
    record tab-entry {
        id: string,
        name: string,
        active: bool,
        workspace: string,
        workspace-id: uuid,
    }

    // Pane-level queries.
    query pane-state(id: uuid) -> pane-state?;
    query focused-pane(session: uuid) -> uuid?;
    query zoomed-pane(session: uuid) -> uuid?;
    query list-panes(session: uuid) -> list<pane-state>;
    query list-floating-panes(session: uuid?) -> list<floating-pane-state>;

    record active-tab-pane-set {
        tab-id: uuid,
        session-id: uuid,
        pane-ids: list<uuid>,
    }

    variant active-tab-pane-query-error {
        no-active-tab,
        no-selected-session,
        failed { reason: string },
    }

    // Tab-level queries.
    query list-tabs(session: string?) -> list<tab-entry>;
    query active-tab-panes()
        -> result<active-tab-pane-set, active-tab-pane-query-error>;
}

@capability(TABS_READ)
interface tabs-catalog-v1 {
    // Complete discovery in workspace order, then each workspace's tab arrangement.
    // Reading this catalog never initializes or rewrites arrangement storage.
    query list-tabs() -> result<list<tabs-state.tab-entry>, string>;
}

@capability(TABS_WRITE)
interface tabs-commands {
    // Errors a focus command can produce.
    variant focus-error {
        pane-not-found,
        focus-denied { reason: string },
    }

    // Errors a close command can produce.
    variant close-error {
        pane-not-found,
        close-denied { reason: string },
    }

    // Errors a tab-level command can produce.
    variant tab-error {
        not-found,
        denied { reason: string },
        failed { reason: string },
    }

    // Errors a pane mutation command (split/launch/resize/zoom/
    // restart) can produce.
    variant pane-mutation-error {
        pane-not-found,
        session-not-found,
        invalid-argument { reason: string },
        denied { reason: string },
        failed { reason: string },
    }

    // Acknowledgement returned by mutating tab commands. When a new
    // tab is created, `id` carries the new context id; other
    // commands may leave it empty.
    record tab-ack {
        ok: bool,
        id: string?,
    }

    // Acknowledgement returned by pane-mutation commands. `pane-id`
    // carries the freshly-created pane id for split/launch; other
    // commands leave it empty.
    record pane-ack {
        ok: bool,
        pane-id: uuid?,
    }

    // Acknowledgement returned by `zoom-pane`. Carries the pane that
    // was toggled plus the post-toggle zoom state so callers can
    // render an accurate status without a follow-up query.
    record pane-zoom-ack {
        pane-id: uuid,
        zoomed: bool,
    }

    // Direction in which a pane split/focus action moves.
    enum pane-direction {
        @default horizontal,
        vertical,
        left,
        right,
        up,
        down,
    }

    // Directional intent for resizing a pane. Increase/decrease grow or
    // shrink the focused pane automatically; physical directions move
    // the nearest boundary on that side.
    enum pane-resize-direction {
        @default increase,
        decrease,
        left,
        right,
        up,
        down,
    }

    // Directional intent for moving a floating pane.
    enum floating-pane-move-direction {
        @default right,
        left,
        up,
        down,
    }

    // Placement for moving a tab relative to another tab.
    enum tab-move-placement {
        @default before,
        after,
    }

    // Selector identifying a session or pane. Exactly one of `id`,
    // `name`, or `index` should be populated. `id` wins when multiple
    // are set. `index` is only meaningful for pane selectors scoped
    // to a session.
    record selector {
        id: uuid?,
        name: string?,
        index: u32?,
    }

    // Pane-level commands.
    command focus-pane(id: uuid) -> result<unit, focus-error>;
    command close-pane(id: uuid) -> result<unit, close-error>;
    // Selector-targeted variants. These accept the full `selector`
    // record (id / name / index / active-by-empty) so callers that
    // address panes by position within a session don't have to resolve
    // an id first.
    command focus-pane-by-selector(session: selector?, target: selector)
        -> result<pane-ack, pane-mutation-error>;
    command close-pane-by-selector(session: selector?, target: selector)
        -> result<pane-ack, pane-mutation-error>;
    // Close the currently-active pane in the targeted session.
    // Equivalent to `close-pane-by-selector` with an empty target, but
    // gives consumers a dedicated name that documents the "close active
    // pane" semantic.
    command close-active-pane(session: selector?)
        -> result<pane-ack, pane-mutation-error>;
    // Focus the next/previous pane in the layout relative to the
    // currently-active pane. The direction is interpreted by the host
    // today; once the tabs plugin owns focus ordering internally,
    // this shifts to a plugin-local lookup.
    command focus-pane-in-direction(session: selector?, direction: pane-direction)
        -> result<pane-ack, pane-mutation-error>;

    // Split / launch / resize / zoom / restart.
    // Each targets a session (by uuid or name) and an existing pane
    // (likewise), plus operation-specific extras.
    command split-pane(
        session: selector?,
        target: selector?,
        direction: pane-direction,
        ratio-pct: u32?,
    ) -> result<pane-ack, pane-mutation-error>;

    command launch-pane(
        session: selector?,
        target: selector?,
        direction: pane-direction,
        name: string?,
        program: string,
        args: list<string>,
    ) -> result<pane-ack, pane-mutation-error>;

    command resize-pane(
        session: selector?,
        target: selector?,
        direction: pane-resize-direction,
        cells: u16,
    ) -> result<pane-ack, pane-mutation-error>;

    command zoom-pane(
        session: selector?,
    ) -> result<pane-zoom-ack, pane-mutation-error>;

    command restart-pane(
        session: selector?,
        target: selector?,
    ) -> result<pane-ack, pane-mutation-error>;

    command create-floating-pane(
        session: selector?,
        target: selector?,
        x: u16?,
        y: u16?,
        w: u16?,
        h: u16?,
        z: i32?,
        layer: string?,
        scope: string?,
        program: string?,
        args: list<string>,
    ) -> result<pane-ack, pane-mutation-error>;

    command move-floating-pane(
        session: selector?,
        target: selector,
        x: u16,
        y: u16,
    ) -> result<pane-ack, pane-mutation-error>;

    command resize-floating-pane(
        session: selector?,
        target: selector,
        w: u16,
        h: u16,
    ) -> result<pane-ack, pane-mutation-error>;

    command move-active-floating-pane(
        session: selector?,
        direction: floating-pane-move-direction,
        cells: u16,
    ) -> result<pane-ack, pane-mutation-error>;

    command resize-active-floating-pane(
        session: selector?,
        direction: pane-resize-direction,
        cells: u16,
    ) -> result<pane-ack, pane-mutation-error>;

    command focus-floating-pane(session: selector?, target: selector)
        -> result<pane-ack, pane-mutation-error>;
    command raise-floating-pane(session: selector?, target: selector)
        -> result<pane-ack, pane-mutation-error>;
    command lower-floating-pane(session: selector?, target: selector)
        -> result<pane-ack, pane-mutation-error>;
    command close-floating-pane(session: selector?, target: selector)
        -> result<pane-ack, pane-mutation-error>;
    command focus-next-floating-pane(session: selector?)
        -> result<pane-ack, pane-mutation-error>;
    command raise-active-floating-pane(session: selector?)
        -> result<pane-ack, pane-mutation-error>;
    command lower-active-floating-pane(session: selector?)
        -> result<pane-ack, pane-mutation-error>;
    command close-active-floating-pane(session: selector?)
        -> result<pane-ack, pane-mutation-error>;

    command set-floating-pane-z(
        session: selector?,
        target: selector,
        z: i32,
    ) -> result<pane-ack, pane-mutation-error>;

    command set-floating-pane-layer(
        session: selector?,
        target: selector,
        layer: string,
    ) -> result<pane-ack, pane-mutation-error>;

    // Tab-level commands.
    command new-tab(name: string?) -> result<tab-ack, tab-error>;
    command rename-tab(name: string) -> result<tab-ack, tab-error>;
    // Rename a specific tab by id, independent of which tab is current.
    command rename-tab-by-id(id: uuid, name: string)
        -> result<tab-ack, tab-error>;
    command kill-tab(target: string, force-local: bool) -> result<tab-ack, tab-error>;
    command kill-all-tabs(force-local: bool) -> result<tab-ack, tab-error>;
    command switch-tab(target: string) -> result<tab-ack, tab-error>;
    command move-tab(source: uuid, target: uuid, placement: tab-move-placement)
        -> result<tab-ack, tab-error>;
}

// Durable personal tab views: per-owner arrangements of references to shared
// tabs. A view never owns a tab's lifetime; removing a reference leaves the
// tab running and discoverable through `tabs-catalog-v1.list-tabs`.
//
// The owner is always the principal bound to the invoking client by the
// host (`clients-identity/v1.current-principal`); no operation accepts an
// owner, and it appears only as returned metadata. View ids are scoped to
// their owner: another owner's views are indistinguishable from absent ones.
@capability(TABS_READ)
@interface-version(1)
interface tabs-personal-views {
    // One reference to a tab (a context id) inside a workspace arrangement.
    // `member-id` is stable identity independent of position and label.
    record personal-member {
        member-id: uuid,
        context-id: uuid,
        // Personal label overriding the shared tab name in this view only.
        label: string?,
    }

    // A workspace arrangement. A workspace without an arrangement has never
    // been initialized; an initialized arrangement may be explicitly empty.
    record personal-workspace {
        workspace-id: uuid,
        initialized: bool,
        members: list<personal-member>,
    }

    // A complete view. Members may reference tabs that are not currently
    // live; projections filter them, and confirmed deletion prunes them.
    record personal-view {
        view-id: uuid,
        owner: uuid,
        name: string,
        schema-version: u32,
        revision: u64,
        is-default: bool,
        workspaces: list<personal-workspace>,
    }

    record personal-view-summary {
        view-id: uuid,
        owner: uuid,
        name: string,
        revision: u64,
        is-default: bool,
    }

    variant personal-view-error {
        // The invoking client has no host-bound principal.
        no-principal,
        // No such view for this owner.
        not-found,
        // The owner has no default view yet, or the workspace has no
        // arrangement yet.
        not-initialized,
        revision-conflict { current-revision: u64 },
        // The mutation id was already used with a different request.
        mutation-conflict,
        // A referenced member, tab or position does not exist, or the
        // request would leave the owner without a valid default.
        invalid-reference,
        already-exists,
        limit-exceeded { limit: string },
        unsupported-version { schema-version: u32 },
        corrupt-state { reason: string },
        storage-unavailable { reason: string },
    }

    // Reading never initializes, seeds or rewrites storage.
    query list-views() -> result<list<personal-view-summary>, personal-view-error>;
    query get-view(view-id: uuid) -> result<personal-view, personal-view-error>;
    query default-view() -> result<personal-view, personal-view-error>;
}

// Mutations of the invoking owner's views. Every command is idempotent per
// owner by `mutation-id`: repeating an id with the same request returns the
// recorded acknowledgement (before revisions are re-evaluated); reusing it
// with a different request fails with `mutation-conflict`. Commands that edit
// a view carry the view revision they expect. Success is returned only after
// the change and its outcome are durably committed together.
@capability(TABS_WRITE)
@interface-version(1)
interface tabs-personal-commands {
    record personal-ack {
        view-id: uuid,
        // The view's revision after the command.
        revision: u64,
        // The member a tab command created, found or edited.
        member-id: uuid?,
    }

    // Create the owner's default view when it has none; otherwise return it.
    command ensure-default(mutation-id: uuid)
        -> result<personal-ack, tabs-personal-views.personal-view-error>;
    command create-view(mutation-id: uuid, view-id: uuid, name: string)
        -> result<personal-ack, tabs-personal-views.personal-view-error>;
    command rename-view(mutation-id: uuid, view-id: uuid, expected-revision: u64, name: string)
        -> result<personal-ack, tabs-personal-views.personal-view-error>;
    // Forget a view. Tabs are never affected. The default view cannot be
    // deleted until another view is the default.
    command delete-view(mutation-id: uuid, view-id: uuid, expected-revision: u64)
        -> result<personal-ack, tabs-personal-views.personal-view-error>;
    command set-default-view(mutation-id: uuid, view-id: uuid)
        -> result<personal-ack, tabs-personal-views.personal-view-error>;
    // Seed the workspace arrangement once from the canonical shared order.
    // An initialized arrangement (even an empty one) is never reseeded.
    command initialize-workspace(
        mutation-id: uuid,
        view-id: uuid,
        expected-revision: u64,
        workspace-id: uuid,
    ) -> result<personal-ack, tabs-personal-views.personal-view-error>;
    // Add a live tab to its workspace's arrangement (seeding it first when
    // uninitialized), before `before` or at the end. A tab already present
    // returns its existing member unchanged and unmoved.
    command add-tab(
        mutation-id: uuid,
        view-id: uuid,
        expected-revision: u64,
        context-id: uuid,
        before: uuid?,
    ) -> result<personal-ack, tabs-personal-views.personal-view-error>;
    // Remove a reference. The tab keeps running and stays discoverable.
    command remove-tab(mutation-id: uuid, view-id: uuid, expected-revision: u64, member-id: uuid)
        -> result<personal-ack, tabs-personal-views.personal-view-error>;
    // Move a member before another member of its workspace, or to the end.
    command move-tab(
        mutation-id: uuid,
        view-id: uuid,
        expected-revision: u64,
        member-id: uuid,
        before: uuid?,
    ) -> result<personal-ack, tabs-personal-views.personal-view-error>;
    // Set or clear (`label` absent) a member's personal label.
    command set-label(
        mutation-id: uuid,
        view-id: uuid,
        expected-revision: u64,
        member-id: uuid,
        label: string?,
    ) -> result<personal-ack, tabs-personal-views.personal-view-error>;
}

// The invoking attachment's binding to one of its owner's personal views.
// A binding is transient, attachment-local state: it is created when a
// client attaches (or on its first call here), defaults to the owner's
// default view, and is retired when the client detaches or disconnects. It
// is never durable. Every operation acts on the invoking attachment, resolved
// by the host; none accepts a client or owner.
//
// `revision` advances whenever the bound view or the selected member changes,
// whatever changed it (including the attachment's own tab switches), so an
// expected revision fails when the binding moved since it was read.
//
// The attachment's projection of its bound view is delivered only to that
// attachment, on the `personal-view` state kind.
@capability(TABS_WRITE)
@interface-version(1)
interface tabs-personal-attachment {
    record personal-binding {
        view-id: uuid,
        revision: u64,
        // The member of the bound view whose tab this attachment has
        // selected, when its selected tab is a member of its active
        // workspace's arrangement.
        selected-member: uuid?,
    }

    variant personal-attachment-error {
        // The invoking client has no live attach stream.
        no-attachment,
        // The invoking client has no host-bound principal.
        no-principal,
        // The owner has no such view.
        not-found,
        revision-conflict { current-revision: u64 },
        // The member is not in the bound view, its tab is not live, or it is
        // not in the attachment's active workspace.
        invalid-reference,
        // The view repository or the selection authority failed.
        unavailable { reason: string },
    }

    // The current binding, created first when the attachment has none.
    command current-binding() -> result<personal-binding, personal-attachment-error>;
    // Bind the attachment to another view of the same owner.
    command bind-view(view-id: uuid, expected-binding-revision: u64)
        -> result<personal-binding, personal-attachment-error>;
    // Select a member's tab through the attachment's ordinary tab selection.
    command select-member(member-id: uuid, expected-binding-revision: u64)
        -> result<personal-binding, personal-attachment-error>;
}

// Edits of the invoking attachment's bound view, addressed by tab (context
// id) the way presentations show it. The tabs plugin resolves the members and
// the current view revision itself, retrying when another attachment edits
// the same view, so no caller supplies a revision or a mutation id. Each
// operation is idempotent by content: adding a member tab, removing an absent
// one or moving a tab to where it already is changes nothing. A workspace the
// view has not arranged yet is seeded from the canonical order first.
@capability(TABS_WRITE)
@interface-version(1)
interface tabs-personal-actions {
    // Add a live tab to the view at the end of its workspace's arrangement,
    // without selecting it.
    command add-tab(context-id: uuid)
        -> result<tabs-personal-commands.personal-ack, tabs-personal-attachment.personal-attachment-error>;
    // Add a live tab when absent, then select it, switching workspace when
    // it lives in another one (finder discovery).
    command open-tab(context-id: uuid)
        -> result<tabs-personal-commands.personal-ack, tabs-personal-attachment.personal-attachment-error>;
    // Remove a tab from the view. The tab keeps running and stays
    // discoverable. Every attachment bound to the view whose selected tab it
    // was moves to the next live member (else the previous one) of the
    // arrangement, or is left with no selection when none remains. The
    // removal is this attachment's last removal, which undo restores.
    command remove-tab(context-id: uuid)
        -> result<tabs-personal-commands.personal-ack, tabs-personal-attachment.personal-attachment-error>;
    // Move a member tab before another member tab of the same arrangement,
    // or to its end.
    command move-tab(context-id: uuid, before: uuid?)
        -> result<tabs-personal-commands.personal-ack, tabs-personal-attachment.personal-attachment-error>;
}

// Personal labels of the invoking attachment's bound view, addressed by tab
// (context id). A label overrides the tab's shared name in this view only;
// renaming the tab itself (`tabs-commands.rename-tab-by-id`) changes the name
// everyone sees. The tabs plugin resolves the member and the current view
// revision itself, retrying when another attachment edits the same view.
@capability(TABS_WRITE)
@interface-version(1)
interface tabs-personal-labels {
    // Set the tab's personal label, or clear it (`label` absent or empty) so
    // the view shows the shared name again. The tab must be a member of the
    // bound view; setting the label it already has changes nothing.
    command set-label(context-id: uuid, label: string?)
        -> result<tabs-personal-commands.personal-ack, tabs-personal-attachment.personal-attachment-error>;
}

// One attachment's projection of its bound personal view, published by the
// tabs plugin only to that attachment (recipient-scoped retained delivery,
// never broadcast). Each publication is complete: members whose tabs are not
// live, or no longer in the arrangement's workspace, are omitted, and names
// already prefer the personal label. `active` reflects this attachment's own
// selection. A projection with the nil `view-id` means none is available.
//
// v2: `last-removed` carries the attachment's last removal for undo.
// v3: `is-default`, each member's `label`, and `following`.
@interface-version(3)
interface personal-view {
    record personal-view-member {
        member-id: uuid,
        context-id: uuid,
        // The personal label when set, otherwise the tab's shared name.
        name: string,
        // The personal label, when this view overrides the shared name.
        label: string?,
        active: bool,
    }

    record personal-view-workspace {
        workspace-id: uuid,
        members: list<personal-view-member>,
    }

    // The attachment's last removal of a tab from this view, which
    // `undo-remove-from-view` restores. Presentations show it as a transient
    // hint, timed from `removed-at-ms` (Unix milliseconds).
    record personal-view-removal {
        context-id: uuid,
        name: string,
        removed-at-ms: u64,
    }

    // The attachment follows another client and shows that client's tab,
    // without adding it to this view. Ending the follow restores the
    // selection the attachment had when it began.
    record personal-view-follow {
        leader-client-id: uuid,
        // The tab shown for the leader.
        context-id: uuid,
        // Its personal label in this view when it is a member, otherwise its
        // shared name.
        name: string,
        // Whether the tab is a member of this view's arrangement.
        in-view: bool,
    }

    record personal-view-projection {
        view-id: uuid,
        name: string,
        // Whether the bound view is the owner's default view.
        is-default: bool,
        view-revision: u64,
        binding-revision: u64,
        // The workspace of the attachment's selected tab (nil: the default
        // workspace).
        active-workspace-id: uuid,
        // Every initialized arrangement of the view, in the view's order.
        // While the attachment has no selection (its arrangement lost its
        // last live tab), `active-workspace-id` is the workspace it was in.
        workspaces: list<personal-view-workspace>,
        last-removed: personal-view-removal?,
        following: personal-view-follow?,
    }

    @state events personal-view-projection;
}

interface tabs-events {
    // A single event describing a pane-level state change.
    variant pane-event {
        // A pane gained focus.
        focused { pane-id: uuid },
        // A pane lost focus.
        unfocused { pane-id: uuid },
        // A pane was zoomed to fill its session viewport.
        zoomed { pane-id: uuid },
        // A zoomed pane was restored.
        unzoomed { pane-id: uuid },
        // A new pane was opened.
        opened { pane-id: uuid, session-id: uuid },
        // A pane was closed.
        closed { pane-id: uuid },
        // The pane's lifecycle status changed (e.g., running -> exited).
        status-changed { pane-id: uuid },
    }

    events pane-event;
}

// Reactive state channel carrying the ordered list of tabs in the
// order consumers should render them (and navigate through). The
// tabs plugin owns the authoritative tab order (persisted in its
// plugin-local storage under `tabs.order`) and publishes a fresh
// snapshot on every mutation: new-tab, rename-tab,
// switch-tab, move-tab, kill-tab, kill-all-tabs,
// goto-tab, close-current-tab, next/prev/last tab.
//
// Subscribers (notably the attach tab bar) consume this via
// `EventBus::subscribe_state::<TabListSnapshot>` to observe the
// current ordered list synchronously plus a live-update receiver.
// This lets the tab bar render the exact order the plugin maintains
// and lets next/prev navigation walk the same order without a
// round-trip query per frame.
//
// Payload semantics:
// - `tabs` is the ordered list of live tabs; consumers render
//   positional indices (`1:`, `2:`, …) from this order.
// - `active` on each entry is `false`. The current tab is per client
//   (each client's own contexts selection) and this snapshot reaches
//   every client, so it marks none; consumers read their client's
//   selection from `tabs-local-view`. Caller-scoped queries
//   (`tabs-state.list-tabs`, `tabs-catalog-v1.list-tabs`) mark the
//   invoking client's current tab.
// - `revision` is a monotonic counter advancing on every publish;
//   consumers can use it to deduplicate or order updates.
// Client-local selection, published by attach rather than the shared catalog.
interface tabs-local-view {
    record tab-selection {
        context-id: uuid?,
    }

    @state events tab-selection;
}

interface tabs-list {
    record tab-list-snapshot {
        tabs: list<tab-list-entry>,
        revision: u64,
    }

    record tab-list-entry {
        id: uuid,
        name: string,
        active: bool,
        workspace: string,
        workspace-id: uuid,
    }

    @state events tab-list-snapshot;
}

// Reactive state channel carrying what each tab is doing, for status
// views such as the sidebar. The tabs plugin derives it from the
// pane runtime's terminal signals (title, OSC 7 directory, bell,
// notifications, OSC 133 exit status), its output activity, each
// pane's running command and the git status of the focused pane's
// directory, and republishes when any of it changes.
//
// Times are milliseconds since the Unix epoch on the server; `now-ms`
// is the server clock at publication, so clients compute ages without
// comparing clocks.
interface tabs-status {
    record git-status {
        branch: string,
        // Uncommitted changes (staged, unstaged or untracked).
        dirty: bool,
        ahead: u32,
        behind: u32,
    }

    enum agent-activity {
        @default idle,
        working,
        // Needs the user to answer or approve something.
        blocked,
    }

    // The tab's most pressing coding agent (blocked, then working, then the
    // focused pane's), from the agents plugin.
    record tab-agent {
        name: string,
        activity: agent-activity,
        // What the agent last said (a report's or a notification's message).
        message: string?,
        changed-at-ms: u64,
        // When it last finished work (went from working to idle).
        finished-at-ms: u64?,
    }

    // What a tab is doing, most pressing first. The tabs plugin decides it
    // once, on the server, for every view to show alike.
    enum tab-state {
        @default idle,
        // Its agent finished or waits at its prompt, and that was seen.
        stopped,
        // Its agent works, or a command runs and prints.
        working,
        // Its agent finished since anyone last looked at the tab.
        done,
        // A command exited non-zero (until seen, or until the next command,
        // by the tabs plugin's `failed_clears` setting).
        failed,
        // Its agent needs an answer or approval, or a pane rang the bell or
        // sent a notification since anyone last looked at the tab.
        needs-input,
    }

    record tab-status {
        tab-id: uuid,
        panes: u32,
        // The focused pane's running command, when one runs.
        running-command: string?,
        // The focused pane's working directory.
        cwd: string?,
        // The focused pane's title, as its program set it.
        title: string?,
        git: git-status?,
        // Exit status of the most recently finished command in the tab.
        last-exit: u32?,
        // When any pane of the tab last produced output.
        output-at-ms: u64?,
        // When any pane of the tab last rang the bell or sent a notification.
        attention-at-ms: u64?,
        // The most recent notification text, when there is one.
        attention: string?,
        agent: tab-agent?,
        // What the tab is doing; a tab looked at is one shown, by any client,
        // in a terminal that has focus.
        state: tab-state,
        // When the tab entered its state, when that is known.
        state-since-ms: u64?,
        // A foreground command in a non-agent pane, preferring the focused pane.
        shell-command: string?,
    }

    record tab-status-snapshot {
        tabs: list<tab-status>,
        now-ms: u64,
        revision: u64,
    }

    @state events tab-status-snapshot;
}

// How many times each tab's panes have rung the bell, counted from what the
// pane runtime retains, so a client notices every bell, including those it
// missed seeing happen. A count that goes down belongs to a restarted program.
interface tabs-bells {
    record tab-bells {
        tab-id: uuid,
        bells: u64,
    }

    record tab-bells-snapshot {
        tabs: list<tab-bells>,
        revision: u64,
    }

    @state events tab-bells-snapshot;
}

/// What `bmux.tabs` provides to and requires from the host and other plugins.
world tabs {
    provide tabs-catalog-v1;
    provide tabs-state;
    provide tabs-commands;
    provide tabs-events capability bmux.tabs.read;
    provide tabs-placement-v1;
    provide tabs-personal-views;
    provide tabs-personal-commands;
    provide tabs-personal-attachment;
    provide tabs-personal-actions;
    provide tabs-personal-labels;
    require capability bmux.commands;
    require capability bmux.contexts.read;
    require capability bmux.contexts.write;
    require capability bmux.clients.read;
    require capability bmux.pane_runtime.read;
    require capability bmux.pane_runtime.write;
    require capability bmux.panes.read;
    require capability bmux.panes.write;
    require capability bmux.sessions.read;
    require capability bmux.sessions.write;
    require capability bmux.workspaces.read;
    require capability bmux.workspaces.write;
    require capability bmux.storage;
    require optional capability bmux.pane_runtime.spawn.v1;
}
