// Public, typed contract of the recording plugin.

plugin bmux.recording version 1;

import pane = bmux.pane_runtime;

capability RECORDING_READ = bmux.recording.read;
capability RECORDING_WRITE = bmux.recording.write;
capability RECORDING_PROCESS_PRESENTATION_WAIT_V1 = bmux.recording.process.presentation.wait.v1;
capability RECORDING_PROCESS_PRESENTATION_V1 = bmux.recording.process.presentation.v1;
capability RECORDING_PROCESS_V4 = bmux.recording.process.v4;

capability RECORDING_PROCESS_ENVIRONMENT_V1 = bmux.recording.process.environment.v1;
capability RECORDING_PROCESS_LIVE_PRESENTATION_V1 = bmux.recording.process.live.presentation.v1;
capability RECORDING_PROCESS_HUMAN_INPUT_V1 = bmux.recording.process.human.input.v1;

@capability(RECORDING_PROCESS_ENVIRONMENT_V1)
interface recording-process-environment-v1 {
    command capabilities() -> u32;
    command start(launch_mutation_id: uuid, options: recording-process-v4.program-options,
        environment: list<pane.environment-entry>) -> result<recording-process-v4.run-status, recording-process-v4.process-error>;
}

@capability(RECORDING_PROCESS_LIVE_PRESENTATION_V1)
interface recording-process-live-presentation-v1 {
    command capabilities() -> pane.live-capabilities;
    command read(run_id: uuid, after: pane.live-cursor?, max_bytes: u32) -> result<pane.live-frame?, pane.live-error>;
    command wait-present(run_id: uuid, after: pane.live-cursor?, timeout_ms: u32, max_bytes: u32) -> result<pane.live-frame?, pane.live-error>;
}

// Volatile input receipts are NOT durable recording receipts. Unknown outcomes
// must not be automatically replayed; finalization still drains durable capture.
@capability(RECORDING_PROCESS_HUMAN_INPUT_V1)
interface recording-process-human-input-v1 {
    command capabilities() -> pane.human-input-capabilities;
    command open(run_id: uuid) -> result<pane.human-input-stream, pane.human-input-error>;
    command push(run_id: uuid, stream: pane.human-input-stream, sequence: u64, data: bytes) -> result<pane.human-input-ack, pane.human-input-error>;
    command close(run_id: uuid, stream: pane.human-input-stream) -> result<unit, pane.human-input-error>;
}

// Additive stateless wait; durable process v4 and presentation v1 are unchanged.
@capability(RECORDING_PROCESS_PRESENTATION_WAIT_V1)
interface recording-process-presentation-wait-v1 {
    command capabilities() -> pane.wait-capabilities;
    command wait-present(run_id: uuid, after: bytes?, timeout_ms: u32, max_bytes: u32)
        -> result<pane.presentation-frame?, pane.wait-error>;
}

// Optional retained presentation for the execution already owned by a v4 run.
@capability(RECORDING_PROCESS_PRESENTATION_V1)
interface recording-process-presentation-v1 {
    command capabilities() -> result<pane.presentation-capabilities, recording-process-v4.process-error>;
    command resize(run_id: uuid, format: pane.terminal-capture-format, cols: u16, rows: u16)
        -> result<unit, recording-process-v4.process-error>;
    command present(run_id: uuid)
        -> result<pane.terminal-execution-screen, recording-process-v4.process-error>;
}

// One process contract. Older process/storage representations are not accepted.
@capability(RECORDING_PROCESS_V4)
interface recording-process-v4 {
    record program-options {
        program: string,
        args: list<string>,
        cwd: string?,
        env: map<string, string>,
        cols: u16,
        rows: u16,
        profile: recording-types.recording-profile,
    }
    record execution-ref {
        session_id: uuid,
        pane_id: uuid,
        execution_token: uuid,
    }
    enum run-phase { starting, running, exited, failed, finalized, recovery-required }
    record run-status {
        schema_version: u32,
        run_id: uuid,
        revision: u64,
        launch_mutation_id: uuid,
        recording_id: uuid,
        execution: execution-ref?,
        runtime_root: string,
        phase: run-phase,
        exit_code: u32?,
        target_exited: bool,
        terminal_session_ended: bool,
        capture_eof: bool,
        // Readiness of canonical capture, never a descendant cleanup indicator.
        output_drained: bool,
        output_watermark: u64,
        capture_watermark: u64,
        recording_watermark: u64,
        capture_finalized: bool,
        durable_recording_complete: bool,
        timing_complete: bool,
        cleanup_complete: bool,
        recovery_required: bool,
        errors: list<string>,
    }
    record output-read {
        run_id: uuid,
        since: u64,
        next_cursor: u64,
        data: bytes,
        complete: bool,
    }
    variant process-error {
        not-found,
        invalid-options { reason: string },
        unavailable { reason: string },
        unsupported-schema { reason: string },
        conflicting-mutation { reason: string },
        recovery-required { reason: string },
        stale-revision,
        still-running,
        capture-failed { reason: string },
        operation-failed { reason: string },
    }
    // Caller persists identity/fingerprint before invoking; service commits intent
    // before reserve/launch and reconciles identical retries without relaunch.
    command start(run_id: uuid, launch_mutation_id: uuid, options: program-options, runtime_root: string)
        -> result<run-status, process-error>;
    command status(run_id: uuid) -> result<run-status, process-error>;
    command reconcile(run_id: uuid) -> result<run-status, process-error>;
    command read(run_id: uuid, since: u64, max_bytes: u32) -> result<output-read, process-error>;
    command screen(run_id: uuid) -> result<string, process-error>;
    command send(run_id: uuid, data: bytes, mutation_id: uuid) -> result<pane.terminal-input-receipt, process-error>;
    command input-receipt(run_id: uuid, mutation_id: uuid) -> result<pane.terminal-input-receipt, process-error>;
    command resolve(run_id: uuid, mutation_id: uuid, expected_revision: u64, action: pane.terminal-resolution-action, input_mutation_id: uuid?, grace_ms: u32) -> result<pane.terminal-resolution-receipt, process-error>;
    command wait(run_id: uuid, timeout_ms: u32) -> result<run-status, process-error>;
    command terminate(run_id: uuid, grace_ms: u32) -> result<run-status, process-error>;
    command finish(run_id: uuid, expected_revision: u64, terminate_running: bool)
        -> result<run-status, process-error>;
}

interface recording-types {
    enum recording-profile {
        full,
        functional,
        visual,
    }

    enum recording-event-kind {
        pane-input-raw,
        pane-output-raw,
        protocol-reply-raw,
        pane-image,
        server-event,
        request-start,
        request-done,
        request-error,
        custom,
    }

    record recording-summary {
        id: uuid,
        name: string?,
        format_version: u32,
        session_id: uuid?,
        capture_input: bool,
        profile: recording-profile,
        event_kinds: list<recording-event-kind>,
        started_epoch_ms: u64,
        ended_epoch_ms: u64?,
        event_count: u64,
        payload_bytes: u64,
        path: string,
        segments: list<string>,
        total_segment_bytes: u64,
    }

    record recording-status {
        active: recording-summary?,
        queue_len: u64,
    }

    record recording-capture-target {
        recording_id: uuid,
        path: string,
        rolling_window_secs: u64?,
    }

    record recording-rolling-start-options {
        window_secs: u64?,
        name: string?,
        event_kinds: list<recording-event-kind>?,
        capture_input: bool?,
        capture_output: bool?,
        capture_events: bool?,
        capture_protocol_replies: bool?,
        capture_images: bool?,
    }

    record recording-rolling-usage {
        bytes: u64,
        files: u64,
        directories: u64,
        recording_dirs: u64,
    }

    record recording-rolling-status {
        root_path: string,
        auto_start: bool,
        available: bool,
        active: recording-summary?,
        rolling_window_secs: u64?,
        event_kinds: list<recording-event-kind>,
        usage: recording-rolling-usage,
    }

    record recording-rolling-clear-report {
        root_path: string,
        was_active: bool,
        restarted: bool,
        stopped_recording_id: uuid?,
        restarted_recording: recording-summary?,
        usage_before: recording-rolling-usage,
        usage_after: recording-rolling-usage,
    }

    variant recording-job-kind {
        cut,
        export,
        stop-export,
    }

    variant recording-job-status {
        queued,
        cutting,
        cut-completed,
        exporting,
        completed,
        failed,
    }

    record recording-job {
        id: uuid,
        kind: recording-job-kind,
        status: recording-job-status,
        recording_id: uuid?,
        recording_path: string?,
        export_output_path: string?,
        error: string?,
    }

    variant recording-error {
        no-active,
        unavailable,
        failed { reason: string },
    }
}

interface recording-events {
    variant recording-event {
        started { target: recording-types.recording-capture-target },
        stopped { recording_id: uuid },
        cut-started { last_seconds: u64?, name: string? },
        cut-completed { summary: recording-types.recording-summary },
        cut-failed { reason: string },
        export-started { recording_id: uuid, output_path: string },
        export-completed { recording_id: uuid, output_path: string },
        export-failed { recording_id: uuid, output_path: string, reason: string },
        job-updated { job: recording-types.recording-job },
    }

    events recording-event;
}

@capability(RECORDING_READ)
interface recording-state {
    query status() -> recording-types.recording-status;
    query list-recordings() -> list<recording-types.recording-summary>;
    query rolling-status() -> recording-types.recording-rolling-status;
    query capture-targets() -> list<recording-types.recording-capture-target>;
    query job-status(job_id: uuid) -> recording-types.recording-job?;
    query list-jobs() -> list<recording-types.recording-job>;
}

@capability(RECORDING_WRITE)
interface recording-commands {
    command start(
        session_id: uuid?,
        capture_input: bool,
        name: string?,
        profile: recording-types.recording-profile?,
        event_kinds: list<recording-types.recording-event-kind>?,
    ) -> result<recording-types.recording-summary, recording-types.recording-error>;

    command stop(recording_id: uuid?)
        -> result<uuid, recording-types.recording-error>;

    command write-custom-event(
        session_id: uuid?,
        pane_id: uuid?,
        source: string,
        name: string,
        payload: bytes,
    ) -> result<unit, recording-types.recording-error>;

    command delete(recording_id: uuid)
        -> result<uuid, recording-types.recording-error>;

    command delete-all() -> u64;

    command cut(last_seconds: u64?, name: string?)
        -> result<recording-types.recording-summary, recording-types.recording-error>;

    command queue-cut(last_seconds: u64?, name: string?, export_fps: u32?)
        -> recording-types.recording-job;

    command rolling-start(options: recording-types.recording-rolling-start-options)
        -> result<recording-types.recording-summary, recording-types.recording-error>;

    command rolling-stop() -> result<uuid, recording-types.recording-error>;

    command rolling-clear(restart_if_active: bool)
        -> recording-types.recording-rolling-clear-report;

    command prune(older_than_days: u64?) -> u64;
}
