plugin bmux.broadcast version 1;
capability BROADCAST_CONTROL = bmux.broadcast.control.v1;
capability BROADCAST_OUTPUT = bmux.broadcast.output.v1;
capability BROADCAST_TURNKEY = bmux.broadcast.turnkey.v1;
capability BROADCAST_PRESENTATION = bmux.broadcast.presentation.v1;
capability BROADCAST_DIAGNOSTICS = bmux.broadcast.diagnostics.v1;

@capability(BROADCAST_PRESENTATION)
interface broadcast-presentation-v1 {
    // Publication-global status only, not a selected-view/decorations selector.
    // Scoped consumers must not interpret this as ownership of their view.
    record indicator { state: string, revision: u64 }
    command status() -> indicator;
}

@capability(BROADCAST_TURNKEY)
interface broadcast-turnkey-v1 {
    // Public-safe labels only: printable ASCII, 1..64 bytes; never paths/titles.
    record source-descriptor { source_id: string, label: string, selected: bool }
    record publication { token: string, local: string, remote: string, source_id: string?, error_code: string?, viewer_url: string? }
    record broadcast-status { local: string, remote: string, source_id: string?, error_code: string?, viewer_url: string? }
    command register(source_id: string, label: string) -> source-descriptor;
    command sources() -> list<source-descriptor>;
    command status() -> broadcast-status;
    command start-profile(profile: string?, source_id: string) -> publication;
    // Explicit local operator start of an existing source, without ownership transfer
    // or an integration cleanup token. Requires local proof; cannot replace a publication.
    command start-profile-publication(profile: string?, source_id: string) -> broadcast-status;
    // False means superseded/not owned: MUST NOT stop another publication.
    command stop-owned(token: string) -> bool;
}

@capability(BROADCAST_CONTROL)
interface broadcast-control-v1 {
    record status { local: string, remote: string, source_id: string?, error_code: string? }
    command prepare-local() -> bool;
    command authorize(local_proof: bytes) -> bool;
    // Explicit runtime-wide operator controls. Require local proof authorization;
    // unlike scoped controls below, these do not require source ownership.
    command start-publication(endpoint: string, channel: string, credential_file: string, source_id: string) -> status;
    command pause-publication() -> status;
    command resume-publication() -> status;
    command stop-publication() -> status;
    command source-publication(source_id: string) -> status;
    // One process-wide publication. Start/source require caller-owned source IDs;
    // pause/resume/stop require the selected source's authenticated owner.
    // No active-client fallback and no cross-owner publication replacement.
    command start(endpoint: string, channel: string, credential_file: string, source_id: string) -> status;
    command pause() -> status;
    command resume() -> status;
    command stop() -> status;
    command status() -> status;
    // Independent output-only terminal observer, NOT a mirror of a client's
    // committed view. This v1 command has no scoped view selector; callers that
    // require a committed-view mirror must publish that view via output-v1.
    command terminal(source_id: string, session_id: string, executable: string, sha256: string, runtime_version: string, cols: u32, rows: u32) -> status;
    command source(source_id: string) -> status;
}

@capability(BROADCAST_OUTPUT)
interface broadcast-output-v1 {
    // source_id identifies one caller-owned committed view, never an active-client
    // alias. A selected ID remains pinned to its owner across lease loss/removal.
    // Source loss is unavailable, not implicit selection of another source.
    // Register/poll renew a six-second lease. Poll at least every two seconds.
    // A changed selected refresh requires re-submission of the current committed
    // complete inline BMWP5 frame, even when the scene revision has not changed.
    record source-state { refresh: u64, selected: bool }
    command register(source_id: string) -> source-state;
    command poll(source_id: string) -> source-state;
    command publish(source_id: string, refresh: u64, frame: bytes) -> bool;
    command unregister(source_id: string) -> bool;
}

// Process-local, bounded, allowlisted diagnostics. No credentials, fences, URLs,
// frame payloads or peer-supplied text. Ages use a monotonic clock in milliseconds.
@capability(BROADCAST_DIAGNOSTICS)
interface broadcast-diagnostics-v1 {
    record failure { attempt_id: u64, operation: string, reason: string, age_ms: u64 }
    record event { process_instance: string, controller_instance: string, sequence: u64, attempt_id: u64, operation: string, kind: string, reason: string?, generation: string?, revision: u64?, http_status: u32?, refresh: u64, age_ms: u64 }
    record snapshot {
        process_instance: string, controller_instance: string,
        current_failures: list<failure>,
        source_generation: string?, send_generation: string?, ack_generation: string?, ack_latency_ms: u64?,
        observer_state: string?, observer_exit: string?, observer_age_ms: u64?,
        local: string, remote: string, progress: string, refresh: u64,
        current_failure: failure?, last_failure: failure?, local_error_code: string?,
        source_poll_age_ms: u64?, source_polls: u64, source_lease_remaining_ms: u64?,
        source_age_ms: u64?, source_revision: u64?, ack_age_ms: u64?, ack_revision: u64?, pending_age_ms: u64?,
        send_age_ms: u64?, send_revision: u64?, frames_sent: u64, full_frames: u64, delta_frames: u64, bytes_sent: u64,
        source_frames: u64, attempts: u64, acknowledgements: u64, repairs: u64, failures: u64,
        suppressed: u64, coalesced: u64, latest_event: u64, history_capacity: u32, stall_after_ms: u64
    }
    command status() -> snapshot;
    // Oldest to newest, clamped to 256 entries. Zero returns no entries.
    command events(last: u32) -> list<event>;
}
