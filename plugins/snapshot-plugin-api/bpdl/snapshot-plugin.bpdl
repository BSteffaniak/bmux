// Public, typed contract of the snapshot plugin.

plugin bmux.snapshot version 1;

capability SNAPSHOT_READ = bmux.snapshot.read;
capability SNAPSHOT_WRITE = bmux.snapshot.write;

capability SNAPSHOT_PARTICIPANT_READ_V1 = bmux.snapshot.participant.read.v1;
capability SNAPSHOT_PARTICIPANT_WRITE_V1 = bmux.snapshot.participant.write.v1;

// IDs identify retained participants, not executable handles. Listing preserves
// authoritative registration order. Restore always validates before mutation.
interface snapshot-participant-types-v1 {
    record participant-snapshot {
        participant_id: string,
        schema_version: u32,
        payload: bytes,
    }
    variant participant-error {
        unavailable { message: string },
        invalid { message: string },
        failed { message: string },
    }
}

@capability(SNAPSHOT_PARTICIPANT_READ_V1)
interface snapshot-participant-state-v1 {
    query participants() -> result<list<string>, snapshot-participant-types-v1.participant-error>;
    query restore-dependencies(participant_id: string) -> result<list<string>, snapshot-participant-types-v1.participant-error>;
    query snapshot(participant_id: string) -> result<snapshot-participant-types-v1.participant-snapshot, snapshot-participant-types-v1.participant-error>;
    query validate(snapshot: snapshot-participant-types-v1.participant-snapshot) -> result<unit, snapshot-participant-types-v1.participant-error>;
}

@capability(SNAPSHOT_PARTICIPANT_WRITE_V1)
interface snapshot-participant-commands-v1 {
    command quiesce(participant_id: string) -> result<unit, snapshot-participant-types-v1.participant-error>;
    command restore(snapshot: snapshot-participant-types-v1.participant-snapshot) -> result<unit, snapshot-participant-types-v1.participant-error>;
}

interface snapshot-types {
    record snapshot-status-payload {
        enabled: bool,
        path: string?,
        snapshot_exists: bool,
        last_write_epoch_ms: u64?,
        last_restore_epoch_ms: u64?,
        last_restore_error: string?,
    }

    record snapshot-save-result {
        path: string?,
    }

    record snapshot-dry-run-result {
        ok: bool,
        message: string,
    }

    record snapshot-apply-summary {
        restored_plugins: u64,
        failed_plugins: u64,
    }

    variant snapshot-error {
        not-registered { message: string },
        lock-poisoned { message: string },
        no-runtime { message: string },
        failed { code: string, message: string },
    }
}

@capability(SNAPSHOT_READ)
interface snapshot-state {
    query status() -> result<snapshot-types.snapshot-status-payload, snapshot-types.snapshot-error>;
    query restore-dry-run() -> result<snapshot-types.snapshot-dry-run-result, snapshot-types.snapshot-error>;
}

@capability(SNAPSHOT_WRITE)
interface snapshot-commands {
    command save-now() -> result<snapshot-types.snapshot-save-result, snapshot-types.snapshot-error>;
    command restore-apply() -> result<snapshot-types.snapshot-apply-summary, snapshot-types.snapshot-error>;
}

/// What `bmux.snapshot` provides to and requires from the host and other plugins.
world snapshot {
    provide snapshot-participant-state-v1;
    provide snapshot-participant-commands-v1;
    provide snapshot-state;
    provide snapshot-commands;
}
