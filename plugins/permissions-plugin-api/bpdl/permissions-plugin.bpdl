// Public, typed contract of the permissions plugin.

plugin bmux.permissions version 1;

capability PERMISSIONS_READ = bmux.permissions.read;
capability PERMISSIONS_WRITE = bmux.permissions.write;
capability SESSIONS_POLICY = bmux.sessions.policy;

@capability(PERMISSIONS_READ)
@access(observe)
interface permissions-state {
    record permission-entry {
        client-id: string,
        role: string,
    }

    query list-permissions(session: string) -> list<permission-entry>;
}

@capability(PERMISSIONS_WRITE)
@access(owner-local)
interface permissions-commands {
    record command-ack {
        ok: bool,
    }

    command grant(session: string, client-id: string, role: string) -> command-ack;
    command revoke(session: string, client-id: string) -> command-ack;
}

// Roles of remote principals (paired devices), checked for every request on
// an admitted stream: `full` allows observe, input and manage; `view-only`
// allows observe. Nothing allows owner-local routes remotely.
interface remote-role-types {
    enum remote-role {
        full,
        view-only,
    }

    record remote-role-ack {
        ok: bool,
    }
}

@capability(PERMISSIONS_WRITE)
@access(owner-local)
interface remote-role-commands {
    command set-remote-role(principal-id: uuid, role: remote-role-types.remote-role) -> remote-role-types.remote-role-ack;
    command clear-remote-role(principal-id: uuid) -> remote-role-types.remote-role-ack;
}

@capability(PERMISSIONS_READ)
@access(owner-local)
interface remote-role-state {
    query remote-role(principal-id: uuid) -> remote-role-types.remote-role?;
}

// Providers serving an admitted caller ask this on that caller's stream.
@capability(SESSIONS_POLICY)
@access(observe)
interface session-policy-state {
    record session-policy-check-response {
        allowed: bool,
        reason: string?,
    }

    record hot-path-override-entry {
        plugin-id: string,
        capability: string,
        execution-class: string,
        scope: string,
        session-id: uuid?,
        context-id: uuid?,
    }

    record hot-path-decision-response {
        allowed: bool,
        reason: string?,
        matched-scope: string?,
        session-id: uuid?,
        context-id: uuid?,
    }

    query check(
        session-id: uuid,
        context-id: uuid?,
        client-id: uuid,
        principal-id: uuid,
        action: string,
        plugin-id: string?,
        capability: string?,
        execution-class: string?,
    ) -> session-policy-check-response;

    query list-hot-path-overrides(
        session: string?,
        context: string?,
    ) -> list<hot-path-override-entry>;

    query resolve-hot-path-decision(
        plugin-id: string,
        capability: string,
        execution-class: string,
        session: string?,
        context: string?,
    ) -> hot-path-decision-response;
}

@capability(SESSIONS_POLICY)
@access(owner-local)
interface session-policy-commands {
    record command-ack {
        ok: bool,
    }

    command grant-hot-path-override(
        plugin-id: string,
        capability: string,
        execution-class: string,
        scope: string,
        session: string?,
        context: string?,
    ) -> command-ack;

    command revoke-hot-path-override(
        plugin-id: string,
        capability: string,
        execution-class: string,
        scope: string,
        session: string?,
        context: string?,
    ) -> command-ack;
}

/// What `bmux.permissions` provides to and requires from the host and other plugins.
world permissions {
    provide permissions-state;
    provide permissions-commands;
    provide session-policy-state;
    provide session-policy-commands;
    provide remote-role-commands;
    provide remote-role-state;
    require capability bmux.clients.read;
    require capability bmux.commands;
    require capability bmux.contexts.read;
    require capability bmux.pane_runtime.write;
    require capability bmux.sessions.read;
    require capability bmux.storage;
}
