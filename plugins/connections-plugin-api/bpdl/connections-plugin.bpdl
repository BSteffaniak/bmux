// Typed contract of the connections plugin: remote hosting administration
// (owner-local), hosting status (observe), and typed service invocation on a
// selected endpoint (local or a saved host).

plugin bmux.connections version 1;

capability CONNECTIONS_READ = bmux.connections.read;
capability CONNECTIONS_INVOKE = bmux.connections.invoke;
capability CONNECTIONS_HOSTING = bmux.connections.hosting;

interface connection-types {
    enum service-invoke-kind {
        invoke-query,
        invoke-command,
    }

    record invocation-options {
        timeout_ms: u64,
        max_attempts: u32,
        retry_backoff_ms: u64,
    }

    record service-invocation {
        target: string,
        capability: string,
        kind: service-invoke-kind,
        interface_id: string,
        operation: string,
        payload: bytes,
        options: invocation-options?,
    }

    variant connection-error {
        target-not-found { target: string },
        invalid-target { target: string, reason: string },
        unsupported-transport { target: string, transport: string },
        authentication-failed { target: string, reason: string },
        trust-failed { target: string, reason: string },
        connection-failed { target: string, reason: string },
        cancelled { target: string },
        timed-out { target: string, phase: string, timeout_ms: u64 },
        retry-exhausted { target: string, attempts: u32, reason: string },
        service-failed { target: string, reason: string },
    }
}

// Invoking a service on another host uses this machine's device key, so it
// is never reachable from a remote stream.
@capability(CONNECTIONS_INVOKE)
@access(owner-local)
interface connections-commands {
    command invoke-service(invocation: connection-types.service-invocation) -> result<bytes, connection-types.connection-error>;
}

interface saved-host-types {
    record saved-host {
        // The name this machine saved the host under (`bmux connect --pair --name`).
        alias: string,
        // The host's pinned public key (its Iroh endpoint id).
        host_key: string,
        // `direct` or `relay`, from the last connection.
        last_path: string?,
    }
}

// The hosts this machine has paired with (its client known hosts), so other
// plugins can name them as endpoints for `invoke-service`. Owner-local: a
// remote principal never learns where this machine connects.
@capability(CONNECTIONS_INVOKE)
@access(owner-local)
interface saved-hosts-state {
    query list-saved-hosts() -> list<saved-host-types.saved-host>;
}

interface hosting-types {
    enum device-role {
        full,
        view-only,
    }

    enum device-state {
        pending,
        active,
        revoked,
    }

    record device {
        // Device public key (its Iroh endpoint id).
        device_key: string,
        principal: uuid,
        // Untrusted display label.
        name: string,
        state: device-state,
        role: device-role,
        revision: u64,
        approved_at: u64?,
        last_seen: u64?,
    }

    record live-connection {
        device_key: string,
        name: string,
        // `direct` or `relay`.
        path: string,
        rtt_ms: u64?,
        connected_secs: u64,
    }

    record hosting-status {
        enabled: bool,
        // Where `enabled` comes from: `config`, `remote enable`, `remote disable` or `default`.
        source: string,
        endpoint_id: string,
        bound_addrs: list<string>,
        relay_mode: string,
        relay: string?,
        // Whether the endpoint is connected to its home relay.
        relay_connected: bool,
        // Latest measured latency to the home relay.
        relay_latency_ms: u64?,
        // Hosting failed to start; local terminals still work.
        warning: string?,
    }

    enum audit-event-kind {
        paired,
        pair-rejected,
        revoked,
        role-changed,
        connected,
        disconnected,
        refused,
    }

    // One audit log entry. Never carries secrets (no links, keys' secrets or
    // pairing phrases).
    record audit-event {
        // Unix seconds.
        at: u64,
        kind: audit-event-kind,
        device_key: string?,
        // Untrusted display label.
        device_name: string?,
        role: device-role?,
        // For example the path of a connection or why it was refused.
        detail: string?,
    }

    record pairing-session {
        session_id: string,
        // Display explicitly to the owner; never log it.
        @secret link: string,
        expires_at: u64,
    }

    enum pairing-event-kind {
        request,
        withdrawn,
        ended,
        idle,
    }

    record pairing-event {
        kind: pairing-event-kind,
        request_id: string?,
        device_name: string?,
        device_key: string?,
        phrase: string?,
        // For `ended`: rejected, expired, cancelled, invalid, busy or failed.
        reason: string?,
    }
}

@capability(CONNECTIONS_HOSTING)
@access(owner-local)
interface hosting-commands {
    command set-enabled(enabled: bool) -> hosting-types.hosting-status;
    command begin-pairing(role: hosting-types.device-role, name: string?, ttl_seconds: u64) -> hosting-types.pairing-session;
    // Waits up to wait_ms for the next pairing event (pushed, not polled).
    command next-pairing-event(session_id: string, wait_ms: u64) -> hosting-types.pairing-event;
    command decide-pairing(session_id: string, request_id: string, approve: bool) -> hosting-types.device?;
    command end-pairing(session_id: string) -> bool;
    command revoke-device(device: string) -> hosting-types.device;
    command set-device-role(device: string, role: hosting-types.device-role) -> hosting-types.device;
}

@capability(CONNECTIONS_HOSTING)
@access(owner-local)
interface hosting-admin-state {
    query list-devices() -> list<hosting-types.device>;
    query live-connections() -> list<hosting-types.live-connection>;
    // The newest `limit` audit events, oldest first.
    query audit-log(limit: u32) -> list<hosting-types.audit-event>;
}

@capability(CONNECTIONS_READ)
@access(observe)
interface hosting-state {
    query status() -> hosting-types.hosting-status;
}

/// What `bmux.connections` provides to and requires from the host and other plugins.
world connections {
    provide connections-commands;
    provide saved-hosts-state;
    provide hosting-commands;
    provide hosting-admin-state;
    provide hosting-state;
    require capability bmux.commands;
    require capability bmux.permissions.write;
    require capability bmux.permissions.read;
}
