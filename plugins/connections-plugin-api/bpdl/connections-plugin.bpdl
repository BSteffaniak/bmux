// Stable transport-neutral endpoint resolution and invocation contract.

plugin bmux.connections version 1;

capability CONNECTIONS_READ = bmux.connections.read;
capability CONNECTIONS_INVOKE = bmux.connections.invoke;
capability CONNECTIONS_PAIRING = bmux.connections.pairing;

interface connection-types {
    enum connection-transport {
        local,
        ssh,
        tls,
        iroh,
    }

    enum service-invoke-kind {
        invoke-query,
        invoke-command,
    }

    record resolved-endpoint {
        endpoint_id: string,
        reference: string,
        label: string,
        transport: connection-transport,
        address: string,
        server_name: string?,
        connect_timeout_ms: u64,
    }

    record invocation-options {
        timeout_ms: u64,
        max_attempts: u32,
        retry_backoff_ms: u64,
    }

    record service-invocation {
        target: string,
        capability: string,
        kind: service-invoke-kind,
        interface_id: string,
        operation: string,
        payload: bytes,
        options: invocation-options?,
    }

    variant connection-error {
        target-not-found { target: string },
        invalid-target { target: string, reason: string },
        unsupported-transport { target: string, transport: string },
        authentication-failed { target: string, reason: string },
        trust-failed { target: string, reason: string },
        connection-failed { target: string, reason: string },
        cancelled { target: string },
        timed-out { target: string, phase: string, timeout_ms: u64 },
        retry-exhausted { target: string, attempts: u32, reason: string },
        service-failed { target: string, reason: string },
    }
}

// Device admission grants access to this runtime only, not cluster membership.
interface pairing-types {
    enum device-access {
        denied,
        full-local-runtime,
    }
    record admission-binding {
        subject_id: uuid,
        lease_id: uuid,
    }
    record listener-status {
        endpoint_id: string,
        enabled: bool,
        endpoint_address: string?,
        // Pinned device endpoint URIs, one per advertised direct address/relay.
        endpoint_targets: list<string>,
        // Optional ingress failed; local terminal operation remains available.
        warning: string?,
    }
    record device {
        device_id: string,
        device_key: string,
        access: device-access,
        revision: u64,
    }
    variant stream-provenance {
        local,
        admitted { subject_id: uuid, lease_id: uuid },
        invalid,
    }
    record device-access-check {
        access: device-access,
        revision: u64,
    }
    record invitation {
        invitation_id: string,
        endpoint_id: string,
        device_key: string,
        @secret secret: bytes,
        expires_at: u64,
        access: device-access,
        // Sign these exact bytes with the device Iroh secret key.
        @secret possession_message: bytes,
    }
    enum session-phase {
        waiting-peer,
        pending-approval,
        pending-grant,
        active,
        rejected,
        cancelled,
        expired,
    }
    record pairing-session {
        session_id: string,
        // Display explicitly; never log this reusable pre-approval secret.
        @secret invitation_link: string,
        expires_at: u64,
    }
    record pairing-request {
        session_id: string,
        phase: session-phase,
        peer_key: string?,
        // Untrusted display label, authenticated as part of the transcript.
        device_name: string?,
        verification_phrase: string?,
        device_id: string?,
        expires_at: u64,
    }
    record admission-challenge {
        @secret challenge: bytes,
        @secret possession_message: bytes,
    }
}

// The capability is discoverability, not owner authority. Handlers additionally
// require host-trusted local owner provenance for administrative operations.
@capability(CONNECTIONS_PAIRING)
interface pairing-commands {
    command set-enabled(enabled: bool) -> pairing-types.listener-status;
    command start-listener() -> pairing-types.listener-status;
    // Local owner authorizes this exact host and invitation-bound device key.
    command pair-endpoint(target: string, invitation: pairing-types.invitation) -> string;
    command stop-listener() -> pairing-types.listener-status;
    command create-invitation(device_key: string, ttl_seconds: u64, access: pairing-types.device-access) -> pairing-types.invitation;
    command redeem-invitation(invitation_id: string, @secret secret: bytes, @secret signature: bytes) -> pairing-types.device;
    command grant-device(device_id: string, access: pairing-types.device-access) -> pairing-types.device;
    command revoke-device(device_id: string) -> pairing-types.device;
    command begin-admission(device_id: string) -> pairing-types.admission-challenge;
    command finish-admission(@secret challenge: bytes, @secret signature: bytes) -> bytes;
}

@capability(CONNECTIONS_PAIRING)
interface pairing-state {
    query local-device-identity() -> string;
    query listener-status() -> pairing-types.listener-status;
    query current-provenance() -> pairing-types.stream-provenance;
    query list-devices() -> list<pairing-types.device>;
    query check-device-access(subject_id: uuid) -> pairing-types.device-access-check;
}

@capability(CONNECTIONS_READ)
interface connections-state {
    query resolve(target: string) -> result<connection-types.resolved-endpoint, connection-types.connection-error>;
    query list-targets() -> list<connection-types.resolved-endpoint>;
}

@capability(CONNECTIONS_INVOKE)
interface connections-commands {
    command invoke-service(invocation: connection-types.service-invocation) -> result<bytes, connection-types.connection-error>;
}

// Owner-only short operations. Handler must prove trusted local owner provenance.
@capability(CONNECTIONS_PAIRING)
interface pairing-session-commands {
    command begin-session(ttl_seconds: u64, endpoint_targets: list<string>) -> pairing-types.pairing-session;
    command approve-session(session_id: string, verification_phrase: string) -> pairing-types.device;
    command reject-session(session_id: string) -> pairing-types.pairing-request;
    command cancel-session(session_id: string) -> pairing-types.pairing-request;
}
@capability(CONNECTIONS_PAIRING)
interface pairing-session-state {
    query pending-request(session_id: string) -> pairing-types.pairing-request;
}
// Only this generated surface is exposed to an unadmitted Iroh peer.
@capability(CONNECTIONS_PAIRING)
interface pairing-peer-commands {
    command submit-pairing(session_id: string, @secret nonce: bytes, @secret signature: bytes, device_name: string?) -> pairing-types.pairing-request;
    command poll-pairing(session_id: string, @secret nonce: bytes) -> pairing-types.pairing-request;
    command pairing-result(session_id: string, @secret nonce: bytes) -> pairing-types.device;
}

// Private host-selected provider. Every operation also requires HostInternal
// provenance; ordinary local and admitted callers are rejected.
@capability(CONNECTIONS_PAIRING)
interface admission-provider-state {
    query probe() -> uuid;
    query validate(subject_id: uuid, lease_id: uuid) -> bool;
}
@capability(CONNECTIONS_PAIRING)
interface admission-provider-commands {
    command consume(@secret ticket: bytes) -> pairing-types.admission-binding;
}
