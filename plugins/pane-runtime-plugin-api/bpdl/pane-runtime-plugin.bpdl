// Public, typed contract of the pane-runtime plugin.
//
// The pane-runtime plugin owns every PTY handle + layout tree in the
// bmux process; core server code dispatches through the typed
// services declared here.
//
// Interfaces:
// - `pane-runtime-state`  — read queries over pane + session runtime.
// - `pane-runtime-commands` — mutating commands (split / launch /
//   focus / resize / close / restart / zoom / direct-input / create /
//   destroy sessions with runtime, restore from snapshot).
// - `attach-runtime-commands` — per-client attach lifecycle (attach
//   session, attach context, open, send input, request output batch,
//   set viewport, detach).
// - `attach-runtime-state` — attach-view queries (layout, snapshot,
//   pane-snapshot, pane-images, pane-output-batch).
// - `pane-runtime-events`  — pane + attach lifecycle event stream.

plugin bmux.pane_runtime version 1;

capability PANE_RUNTIME_EXECUTION_V1 = bmux.pane_runtime.execution.v1;
capability PANE_RUNTIME_EXECUTION_V2 = bmux.pane_runtime.execution.v2;
capability PANE_RUNTIME_READ = bmux.pane_runtime.read;
capability PANE_RUNTIME_WRITE = bmux.pane_runtime.write;
capability ATTACH_RUNTIME_WRITE = bmux.attach_runtime.write;
capability ATTACH_RUNTIME_READ = bmux.attach_runtime.read;
capability PANE_RUNTIME_SPAWN_V1 = bmux.pane_runtime.spawn.v1;

// Exact execution controls. A replacement never inherits the old token.
@capability(PANE_RUNTIME_EXECUTION_V1)
interface pane-runtime-execution-v1 {
    record program-options {
        program: string,
        args: list<string>,
        cwd: string?,
        env: map<string, string>,
        cols: u16,
        rows: u16,
    }
    record execution-ref {
        session_id: uuid,
        pane_id: uuid,
        execution_token: uuid,
    }
    enum execution-phase { running, exited, failed }
    record execution-status {
        execution: execution-ref,
        phase: execution-phase,
        exit_code: u32?,
        signal: string?,
        output_drained: bool,
        output_watermark: u64,
        error: string?,
    }
    variant execution-error {
        unavailable,
        not-found,
        stale-execution,
        denied { reason: string },
        invalid-options { reason: string },
        launch-failed { reason: string },
        operation-failed { reason: string },
    }
    command new-program-session(name: string?, options: program-options)
        -> result<execution-ref, execution-error>;
    record execution-screen {
        execution: execution-ref,
        output_watermark: u64,
        cols: u16,
        rows: u16,
        cursor_col: u16,
        cursor_row: u16,
        cursor_visible: bool,
        text: string,
        // JSON GridSnapshot in the existing bmux_terminal_grid wire format.
        encoded_grid: bytes,
    }
    command screen(execution: execution-ref) -> result<execution-screen, execution-error>;
    command status(execution: execution-ref) -> result<execution-status, execution-error>;
    // Acknowledges queue admission, not child consumption. Payloads are bounded.
    command send(execution: execution-ref, data: bytes) -> result<unit, execution-error>;
    command resize(execution: execution-ref, cols: u16, rows: u16)
        -> result<unit, execution-error>;
    // TERM followed by KILL after grace_ms; returns current state, not a drain promise.
    command terminate(execution: execution-ref, grace_ms: u32)
        -> result<execution-status, execution-error>;
    // Bounded wait for exit AND PTY drain. Timeout returns current status unchanged.
    command wait(execution: execution-ref, timeout_ms: u32)
        -> result<execution-status, execution-error>;
}

// Durable admission and recovery are explicitly negotiated; v1 is unchanged.
@capability(PANE_RUNTIME_EXECUTION_V2)
interface pane-runtime-execution-v2 {
    record program-options {
        program: string,
        args: list<string>,
        cwd: string?,
        env: map<string, string>,
        cols: u16,
        rows: u16,
    }
    record execution-ref {
        session_id: uuid,
        pane_id: uuid,
        execution_token: uuid,
    }
    enum exit-policy { preserve-descendants }
    record capture-cursor {
        execution: execution-ref,
        spool_generation: uuid,
        offset: u64,
    }
    enum launch-phase { reserved, launching, running, exited, uncertain, failed, retired }
    enum input-phase { accepted, writing, completed, uncertain, rejected }
    enum resolution-action { cancel-unstarted, terminate-owned-execution, acknowledge-uncertain-input }
    variant recovery-error {
        denied { reason: string },
        unavailable { reason: string },
        invalid-options { reason: string },
        conflict { reason: string },
        not-found { reason: string },
        capacity { reason: string },
        revision-conflict { actual_revision: u64 },
        recovery-required { reason: string },
        operation-failed { reason: string },
    }
    record launch-reservation {
        execution: execution-ref,
        launch_mutation_id: uuid,
        revision: u64,
        options: program-options,
        policy: exit-policy,
        initial_cursor: capture-cursor,
    }
    record launch-receipt {
        reservation: launch-reservation,
        phase: launch-phase,
        revision: u64,
        exit_code: u32?,
        exit_signal: string?,
        cleanup_complete: bool,
        error: string?,
    }
    record input-receipt {
        execution: execution-ref,
        input_mutation_id: uuid,
        revision: u64,
        phase: input-phase,
        admitted_bytes: u64,
        // Completed means write+flush acknowledged, never child consumption.
        acknowledged_bytes: u64,
        error: string?,
    }
    record supervisor-locator {
        execution: execution-ref,
        protocol_version: u32,
        artifact_sha256: string,
        endpoint: string,
        // Not a credential; reconnect independently authenticates runtime owner.
        generation: u64,
    }
    record reconciliation {
        launch: launch-receipt,
        supervisor: supervisor-locator?,
        // True only when the canonical raw stream has reached EOF without a gap.
        capture_complete: bool,
        oldest_cursor: capture-cursor,
        continuation_cursor: capture-cursor,
        recovery_required: bool,
    }
    record resolution-receipt {
        execution: execution-ref,
        resolution_mutation_id: uuid,
        revision: u64,
        action: resolution-action,
        input_mutation_id: uuid?,
        cleanup_complete: bool,
        recovery_required: bool,
        error: string?,
    }
    record retirement-receipt {
        execution: execution-ref,
        retirement_mutation_id: uuid,
        revision: u64,
        retired: bool,
    }
    record capture-batch {
        cursor: capture-cursor,
        continuation: capture-cursor,
        data: bytes,
        // Caught up to the response watermark, not process EOF.
        complete: bool,
    }
    record capture-gap {
        requested: capture-cursor,
        oldest: capture-cursor,
        continuation: capture-cursor,
        reason: string,
        // Missing snapshot is an explicit unavailable repair, never empty state.
        encoded_grid: bytes?,
        snapshot_cursor: capture-cursor?,
    }
    variant capture-response { batch { value: capture-batch }, gap { value: capture-gap } }
    // Receipts persist until explicit retirement. Capacity rejects new admission.
    command reserve(launch_mutation_id: uuid, options: program-options, policy: exit-policy)
        -> result<launch-reservation, recovery-error>;
    command launch(reservation: launch-reservation) -> result<launch-receipt, recovery-error>;
    command reconcile(execution: execution-ref) -> result<reconciliation, recovery-error>;
    command send(execution: execution-ref, input_mutation_id: uuid, data: bytes)
        -> result<input-receipt, recovery-error>;
    command input-receipt(execution: execution-ref, input_mutation_id: uuid)
        -> result<input-receipt, recovery-error>;
    command resolve(execution: execution-ref, resolution_mutation_id: uuid,
        expected_revision: u64, action: resolution-action, input_mutation_id: uuid?, grace_ms: u32)
        -> result<resolution-receipt, recovery-error>;
    command capture-resume(cursor: capture-cursor, max_bytes: u32)
        -> result<capture-response, recovery-error>;
    // Retirement requires authoritative completed cleanup and resolved uncertainty.
    command retire(execution: execution-ref, retirement_mutation_id: uuid, expected_revision: u64)
        -> result<retirement-receipt, recovery-error>;
}

// Directory-aware creation is opt-in. Legacy contracts retain their meaning.
@capability(PANE_RUNTIME_SPAWN_V1)
interface pane-runtime-spawn-v1 {
    // An execution-host identity, not a client-side filesystem path.
    // The execution token changes on restart even when pane_id is retained.
    record source-execution {
        session_id: uuid,
        pane_id: uuid,
        execution_token: uuid,
    }

    enum observation-method {
        shell,
        process,
    }

    record directory-observation {
        source: source-execution,
        path: string,
        method: observation-method,
    }

    variant spawn-error {
        source-unavailable,
        stale-execution,
        observation-unavailable,
        observation-timeout,
        busy,
        denied { reason: string },
        invalid-directory { path: string, reason: string },
        unsupported-authority,
        launch-failed { reason: string },
        cleanup-failed { reason: string },
    }

    // None deliberately preserves the runtime's unspecified-CWD behavior.
    // A supplied path must be absolute and validated on the execution host.
    // These options apply only to fresh shells, never resurrection snapshots.
    record initial-shell-options {
        cwd: string?,
    }

    // Resolve on the execution authority, never from the invoking client's HOME.
    // Session authorization is required even though this query does not mutate.
    query home-directory(session_id: uuid) -> result<string, spawn-error>;

    // Explicit pane identity is required; caller-local focus is resolved by
    // the owning product plugin, never substituted by this execution service.
    query capture-source(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<source-execution, spawn-error>;

    // The source must be resolved from caller-local intent before mutation.
    // This query must not substitute session-global focus or restored metadata.
    query observe-directory(
        source: source-execution,
    ) -> result<directory-observation, spawn-error>;

}

@capability(PANE_RUNTIME_SPAWN_V1)
interface pane-runtime-spawn-commands-v1 {
    command new-session(
        name: string?,
        options: pane-runtime-spawn-v1.initial-shell-options,
    ) -> result<pane-runtime-commands.session-ack, pane-runtime-spawn-v1.spawn-error>;

    command split-shell(
        session_id: uuid,
        target: uuid,
        direction: string,
        ratio_percent: u8,
        options: pane-runtime-spawn-v1.initial-shell-options,
    ) -> result<pane-runtime-commands.pane-ack, pane-runtime-spawn-v1.spawn-error>;
}


@capability(PANE_RUNTIME_READ)
interface pane-runtime-state {
    record pane-summary {
        id: uuid,
        name: string?,
        shell: string,
        active_command: string?,
        focused: bool,
    }

    record session-pane-list {
        session_id: uuid,
        panes: list<pane-summary>,
    }

    record floating-pane-summary {
        id: uuid,
        pane_id: uuid,
        anchor_pane_id: uuid?,
        context_id: uuid?,
        client_id: uuid?,
        x: u16,
        y: u16,
        w: u16,
        h: u16,
        scope: string,
        layer: string,
        z: i32,
        visible: bool,
        opaque: bool,
        accepts_input: bool,
        cursor_owner: bool,
    }

    record floating-pane-list {
        session_id: uuid,
        panes: list<floating-pane-summary>,
    }

    record pane-process-identity {
        session_id: uuid,
        pane_id: uuid,
        pid: u32?,
        process_group_id: i32?,
    }

    record pane-process-list {
        panes: list<pane-process-identity>,
    }

    variant pane-state-error {
        session-not-found,
        pane-not-found,
    }

    record pane-padding-spec {
        left: u16,
        right: u16,
        top: u16,
        bottom: u16,
        max-content-width: u16?,
        max-content-height: u16?,
        horizontal-alignment: string,
        vertical-alignment: string,
    }

    record pane-padding-rect {
        x: u16,
        y: u16,
        w: u16,
        h: u16,
    }

    record pane-padding-state {
        session-id: uuid,
        pane-id: uuid,
        declarative: pane-padding-spec,
        matched-rule-index: u32?,
        runtime-override: pane-padding-spec?,
        effective: pane-padding-spec,
        source: string,
        outer-rect: pane-padding-rect?,
        base-content-rect: pane-padding-rect?,
        effective-content-rect: pane-padding-rect?,
        persist-runtime-overrides: bool,
    }

    variant pane-padding-state-error {
        session-not-found,
        pane-not-found,
        geometry-unavailable,
    }

    query pane-padding(session-id: uuid, pane-id: uuid?)
        -> result<pane-padding-state, pane-padding-state-error>;

    query list-panes(session_id: uuid?) -> result<session-pane-list, pane-state-error>;
    query get-pane(session_id: uuid, pane_id: uuid)
        -> result<pane-summary, pane-state-error>;
    query list-floating-panes(session_id: uuid)
        -> result<floating-pane-list, pane-state-error>;
    query list-pane-processes() -> result<pane-process-list, pane-state-error>;
    query get-pane-process(session_id: uuid, pane_id: uuid)
        -> result<pane-process-identity, pane-state-error>;
}

@capability(PANE_RUNTIME_WRITE)
interface pane-runtime-commands {
    // Shared acknowledgement carrying the target pane + session id
    // after a mutating command completes. All mutation commands return
    // a result of this or a command-specific error.
    record pane-ack {
        session_id: uuid,
        pane_id: uuid,
    }

    record session-ack {
        session_id: uuid,
    }

    record floating-pane-ack {
        session_id: uuid,
        pane_id: uuid,
        surface_id: uuid,
    }

    variant pane-command-error {
        session-not-found,
        pane-not-found,
        denied { reason: string },
        failed { reason: string },
    }

    // Errors the session-runtime commands can produce. Names are
    // display hints, not identity: session creation does not reject
    // duplicate names. Identity is the UUID assigned at creation.
    variant session-runtime-command-error {
        session-not-found,
        failed { reason: string },
    }

    command set-pane-padding(
        session-id: uuid,
        pane-id: uuid?,
        padding: pane-runtime-state.pane-padding-spec,
    ) -> result<pane-runtime-state.pane-padding-state, pane-command-error>;

    command clear-pane-padding(
        session-id: uuid,
        pane-id: uuid?,
    ) -> result<pane-runtime-state.pane-padding-state, pane-command-error>;

    record pane-padding-preview-token {
        token: uuid,
    }

    record pane-padding-preview-state {
        token: uuid,
        pane-ids: list<uuid>,
        padding: pane-runtime-state.pane-padding-spec,
        panes: list<pane-runtime-state.pane-padding-state>,
    }

    variant pane-padding-persistence {
        runtime,
        snapshot,
    }

    command begin-pane-padding-preview(
        pane-ids: list<uuid>,
        padding: pane-runtime-state.pane-padding-spec,
    ) -> result<pane-padding-preview-state, pane-command-error>;

    command update-pane-padding-preview(
        token: uuid,
        pane-ids: list<uuid>,
        padding: pane-runtime-state.pane-padding-spec,
    ) -> result<pane-padding-preview-state, pane-command-error>;

    command cancel-pane-padding-preview(
        token: uuid,
    ) -> result<pane-padding-preview-token, pane-command-error>;

    command commit-pane-padding-preview(
        token: uuid,
        persistence: pane-padding-persistence,
    ) -> result<list<pane-runtime-state.pane-padding-state>, pane-command-error>;

    // Split an existing pane along the given direction at the given
    // ratio (0.1..=0.9, clamped). Creates a new pane beside the target.
    command split-pane(
        session_id: uuid,
        target: uuid?,
        direction: string,    // "horizontal" | "vertical"
        ratio_percent: u8,    // 10..=90
    ) -> result<pane-ack, pane-command-error>;

    // Launch a new pane with an explicit program + args + cwd + env,
    // splitting from `target` along `direction`.
    command launch-pane(
        session_id: uuid,
        target: uuid?,
        direction: string,    // "horizontal" | "vertical"
        ratio_percent: u8,
        name: string?,
        program: string,
        args: list<string>,
        cwd: string?,
    ) -> result<pane-ack, pane-command-error>;

    // Focus a pane. `target` may be a pane id; when `target` is none,
    // focus moves in `direction` (up/down/left/right/next/prev).
    command focus-pane(
        session_id: uuid,
        target: uuid?,
        direction: string,
    ) -> result<pane-ack, pane-command-error>;

    command resize-pane(
        session_id: uuid,
        target: uuid?,
        direction: string,    // "left" | "right" | "up" | "down"
        cells: u16,
    ) -> result<session-ack, pane-command-error>;

    command close-pane(
        session_id: uuid,
        target: uuid?,
    ) -> result<pane-ack, pane-command-error>;

    command restart-pane(
        session_id: uuid,
        target: uuid?,
    ) -> result<pane-ack, pane-command-error>;

    command zoom-pane(
        session_id: uuid,
    ) -> result<pane-ack, pane-command-error>;

    command create-floating-pane(
        session_id: uuid,
        target: uuid?,
        anchor_pane_id: uuid?,
        context_id: uuid?,
        client_id: uuid?,
        x: u16?,
        y: u16?,
        w: u16?,
        h: u16?,
        z: i32?,
        layer: string?,
        scope: string?,
        name: string?,
        program: string?,
        args: list<string>,
        cwd: string?,
    ) -> result<floating-pane-ack, pane-command-error>;

    command move-floating-pane(
        session_id: uuid,
        pane_id: uuid,
        x: u16,
        y: u16,
    ) -> result<floating-pane-ack, pane-command-error>;

    command resize-floating-pane(
        session_id: uuid,
        pane_id: uuid,
        w: u16,
        h: u16,
    ) -> result<floating-pane-ack, pane-command-error>;

    command focus-floating-pane(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<floating-pane-ack, pane-command-error>;

    command raise-floating-pane(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<floating-pane-ack, pane-command-error>;

    command lower-floating-pane(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<floating-pane-ack, pane-command-error>;

    command set-floating-pane-z(
        session_id: uuid,
        pane_id: uuid,
        z: i32,
    ) -> result<floating-pane-ack, pane-command-error>;

    command set-floating-pane-layer(
        session_id: uuid,
        pane_id: uuid,
        layer: string,
    ) -> result<floating-pane-ack, pane-command-error>;

    command close-floating-pane(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<floating-pane-ack, pane-command-error>;

    // Send raw input bytes directly to a pane. Used for unattached
    // programmatic input (e.g. playbook-driven tests).
    command pane-direct-input(
        session_id: uuid,
        pane_id: uuid,
        data: list<u8>,
    ) -> result<pane-ack, pane-command-error>;

    // Internal input path for a previously generation-fenced worker request.
    command execution-pane-input(
        session_id: uuid,
        pane_id: uuid,
        data: list<u8>,
    ) -> result<pane-ack, pane-command-error>;

    // Remove the deterministic execution runtime, including its final pane.
    command destroy-execution-pane(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<pane-ack, pane-command-error>;

    record environment-entry {
        key: string,
        value: string,
    }

    // Idempotently create the exact deterministic worker execution binding.
    command ensure-execution-pane(
        session_id: uuid,
        pane_id: uuid,
        name: string?,
        program: string,
        args: list<string>,
        cwd: string?,
        env: list<environment-entry>,
        rows: u16,
        cols: u16,
    ) -> result<pane-ack, pane-command-error>;

    // Set the exact PTY dimensions for a pane without changing split layout.
    command pane-set-pty-size(
        session_id: uuid,
        pane_id: uuid,
        rows: u16,
        cols: u16,
    ) -> result<pane-ack, pane-command-error>;

    enum pane-process-signal {
        interrupt,
        terminate,
        kill,
        hangup,
    }

    // Signal the pane process group (or direct process fallback).
    command pane-signal(
        session_id: uuid,
        pane_id: uuid,
        signal: pane-process-signal,
    ) -> result<pane-ack, pane-command-error>;

    // Update the cached write decision for an already-attached client.
    // The permissions plugin calls this when a role changes so pane input
    // stays hot-path local without becoming stale.
    command set-client-write-permission(
        session_id: uuid,
        client_id: uuid,
        allowed: bool,
    ) -> result<u8, pane-command-error>;

    // Spin up a brand-new session runtime (session manager entry +
    // initial pane PTY). Sessions-plugin bridges `new-session` into
    // this operation.
    command new-session-with-runtime(
        name: string?,
    ) -> result<session-ack, session-runtime-command-error>;

    // Tear down a session's runtime (shut down all pane PTYs, flush
    // recording sinks, release attach tokens). Sessions-plugin bridges
    // `kill-session` into this operation.
    command kill-session-runtime(
        session_id: uuid,
        force_local: bool,
    ) -> result<session-ack, session-runtime-command-error>;

    // Restore a session runtime from a snapshot payload. Invoked by
    // the snapshot orchestrator on server startup. Payload is the
    // opaque bytes from `PaneRuntimeSnapshotV1` (deserialized inside
    // the plugin).
    command restore-session-runtime(
        session_id: uuid,
        snapshot_payload: list<u8>,
    ) -> result<session-ack, session-runtime-command-error>;
}

@capability(ATTACH_RUNTIME_WRITE)
interface attach-runtime-commands {
    // Response from `attach-session` / `attach-context`. Carries the
    // attach grant issued by the AttachTokenManager; client re-presents
    // it on `attach-open`.
    record attach-grant {
        token: uuid,
        session_id: uuid,
        context_id: uuid?,
        expires_epoch_ms: u64,
    }

    // Response from `attach-open`. Indicates the open succeeded and
    // describes the stream's terminal capabilities.
    record attach-ready {
        session_id: uuid,
        context_id: uuid?,
        can_write: bool,
    }

    record attach-output {
        data: list<u8>,
    }

    record attach-viewport-set {
        session_id: uuid,
        cols: u16,
        rows: u16,
        top_inset: u16,
        right_inset: u16,
        bottom_inset: u16,
        left_inset: u16,
        context_id: uuid?,
    }

    record attach-retarget-ready {
        session_id: uuid,
        context_id: uuid?,
        can_write: bool,
        cols: u16,
        rows: u16,
        top_inset: u16,
        right_inset: u16,
        bottom_inset: u16,
        left_inset: u16,
    }

    record attach-input-accepted {
        bytes: u32,
    }

    // Selector identifying a session. Exactly one of `id` or `name`
    // should be populated; `id` wins when both are set.
    record session-selector {
        id: uuid?,
        name: string?,
    }

    // Selector identifying a context. Exactly one of `id` or `name`
    // should be populated; `id` wins when both are set.
    record context-selector {
        id: uuid?,
        name: string?,
    }

    variant attach-command-error {
        session-not-found,
        invalid-grant,
        expired-grant,
        denied { reason: string },
        failed { reason: string },
        context-not-found,
    }

    command attach-session(
        selector: session-selector,
        can_write: bool,
    ) -> result<attach-grant, attach-command-error>;

    command attach-context(
        selector: context-selector,
        can_write: bool,
    ) -> result<attach-grant, attach-command-error>;

    command attach-open(
        session_id: uuid,
        attach_token: uuid,
    ) -> result<attach-ready, attach-command-error>;

    record input-capture-ack-v1 {
        nonce: uuid,
        pane_id: uuid,
        recording_suppressed: bool,
    }

    // Suppression is absorbing for this pane lifetime; there is deliberately no
    // resume command that could race late private input. This acknowledgment
    // proves BMUX raw recording suppression only, not external recorder safety.
    command suppress-pane-input-capture-v1(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<bool, attach-command-error>;

    command attach-input(
        session_id: uuid,
        data: list<u8>,
    ) -> result<attach-input-accepted, attach-command-error>;

    command attach-output(
        session_id: uuid,
        max_bytes: u32,
    ) -> result<attach-output, attach-command-error>;

    command attach-set-viewport(
        session_id: uuid,
        cols: u16,
        rows: u16,
        top_inset: u16,
        right_inset: u16,
        bottom_inset: u16,
        left_inset: u16,
        cell_pixel_w: u16,
        cell_pixel_h: u16,
    ) -> result<attach-viewport-set, attach-command-error>;

    command attach-retarget-context(
        context_id: uuid,
        can_write: bool,
        cols: u16,
        rows: u16,
        top_inset: u16,
        right_inset: u16,
        bottom_inset: u16,
        left_inset: u16,
        cell_pixel_w: u16,
        cell_pixel_h: u16,
    ) -> result<attach-retarget-ready, attach-command-error>;

    command set-client-attach-policy(
        allow_detach: bool,
    ) -> result<u8, attach-command-error>;

    command detach() -> result<u8, attach-command-error>;
}

@capability(ATTACH_RUNTIME_READ)
interface attach-runtime-state {
    record pane-chunk {
        pane_id: uuid,
        data: list<u8>,
        stream_start: u64,
        stream_end: u64,
        stream_gap: bool,
        sync_update_active: bool,
    }

    record pane-mouse-protocol {
        pane_id: uuid,
        // JSON-encoded `AttachMouseProtocolState` (schema is server-internal).
        encoded: list<u8>,
    }

    record pane-input-mode {
        pane_id: uuid,
        // JSON-encoded `AttachInputModeState`.
        encoded: list<u8>,
    }

    record attach-layout {
        session_id: uuid,
        context_id: uuid?,
        focused_pane_id: uuid,
        // JSON-encoded layout payload (panes + layout_root + scene + zoomed).
        encoded: list<u8>,
    }

    record attach-snapshot {
        session_id: uuid,
        context_id: uuid?,
        focused_pane_id: uuid,
        zoomed: bool,
        // JSON-encoded layout payload (panes + layout_root + scene).
        layout_encoded: list<u8>,
        chunks: list<pane-chunk>,
        pane_mouse_protocols: list<pane-mouse-protocol>,
        pane_input_modes: list<pane-input-mode>,
    }

    record attach-pane-snapshot {
        chunks: list<pane-chunk>,
        pane_mouse_protocols: list<pane-mouse-protocol>,
        pane_input_modes: list<pane-input-mode>,
    }

    record attach-pane-output-batch {
        chunks: list<pane-chunk>,
        output_still_pending: bool,
    }

    record pane-grid-snapshot {
        pane_id: uuid,
        stream_end: u64,
        encoded: list<u8>,
    }

    record attach-pane-grid-snapshot {
        snapshots: list<pane-grid-snapshot>,
    }

    record pane-grid-window-request {
        pane_id: uuid,
        scrollback_offset: u32,
        rows: u32,
        anchor_total_scrolled_rows: u64?,
        pin_id: u64?,
    }

    enum history-end { continue, hard-break, open }
    variant history-fetch-error {
        stale-capture,
        unavailable,
        invalid-offset,
        budget-exhausted,
        runtime { error: attach-state-error },
    }

    // v1 JSON cells are [UTF-8 text, terminal width, resolved style] tuples.
    record history-slice-v1 {
        encoded: list<u8>,
        next_cell_offset: u64,
        end_kind: history-end,
    }

    query attach-history-slice-v1(
        session_id: uuid,
        pane_id: uuid,
        pin_id: u64,
        capture_id: uuid,
        line_index: u32,
        cell_offset: u32,
        max_columns: u32,
        max_text_bytes: u32,
    ) -> result<history-slice-v1, history-fetch-error>;

    query attach-main-row-slice-v1(
        session_id: uuid,
        pane_id: uuid,
        pin_id: u64,
        capture_id: uuid,
        line_index: u32,
        cell_offset: u32,
        max_columns: u32,
        max_text_bytes: u32,
    ) -> result<history-slice-v1, history-fetch-error>;

    record history-capture-v1 {
        width: u16,
        height: u16,
        // Content before the retained prefix was discarded or is unknown.
        history_truncated: bool,
        // Exclusive logical-line bound within this immutable capture, including
        // the pending open line. Not a projected row count or live-grid index.
        history_line_count: u64,
        capture_id: uuid,
        pin: pane-scrollback-pin,
    }

    query attach-history-capture-v1(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<history-capture-v1, attach-state-error>;

    record pane-scrollback-pin {
        pane_id: uuid,
        pin_id: u64,
        total_scrolled_rows: u64,
        max_scrollback_offset: u32,
        stream_end: u64,
    }

    record pane-scrollback-unpin-ack {
        pane_id: uuid,
        pin_id: u64,
        released: bool,
    }

    record pane-grid-window {
        pane_id: uuid,
        scrollback_offset: u32,
        max_scrollback_offset: u32,
        total_scrolled_rows: u64,
        anchor_delta_rows: u32,
        anchor_clamped: bool,
        stream_end: u64,
        encoded: list<u8>,
    }

    record attach-pane-grid-window {
        windows: list<pane-grid-window>,
    }

    record pane-grid-delta {
        pane_id: uuid,
        base_revision: u64,
        revision: u64,
        desynced: bool,
        encoded: list<u8>,
    }

    record attach-pane-grid-delta {
        deltas: list<pane-grid-delta>,
    }

    record attach-pane-images {
        // JSON-encoded `Vec<AttachPaneImageDelta>`.
        encoded: list<u8>,
    }

    variant attach-state-error {
        not-attached,
        session-not-found,
        failed { reason: string },
    }

    query attach-layout-state(
        session_id: uuid,
    ) -> result<attach-layout, attach-state-error>;

    query attach-snapshot-state(
        session_id: uuid,
        max_bytes_per_pane: u32,
    ) -> result<attach-snapshot, attach-state-error>;

    query attach-pane-snapshot-state(
        session_id: uuid,
        pane_ids: list<uuid>,
        max_bytes_per_pane: u32,
    ) -> result<attach-pane-snapshot, attach-state-error>;

    query attach-pane-output-batch(
        session_id: uuid,
        pane_ids: list<uuid>,
        max_bytes: u32,
    ) -> result<attach-pane-output-batch, attach-state-error>;

    record pane-output-cursor-read {
        data: list<u8>,
        retained_start: u64,
        stream_start: u64,
        stream_end: u64,
        source_end: u64,
        stream_gap: bool,
    }

    // Read one pane by absolute stream cursor without attach-client state.
    query pane-output-cursor-state(
        session_id: uuid,
        pane_id: uuid,
        cursor: u64,
        max_bytes: u32,
    ) -> result<pane-output-cursor-read, attach-state-error>;

    query attach-pane-grid-snapshot-state(
        session_id: uuid,
        pane_ids: list<uuid>,
        max_rows_per_pane: u32,
    ) -> result<attach-pane-grid-snapshot, attach-state-error>;

    // Complete renderer snapshot for one local pane without attach-client state.
    query pane-grid-snapshot-state(
        session_id: uuid,
        pane_id: uuid,
        max_rows: u32,
    ) -> result<pane-grid-snapshot, attach-state-error>;

    query attach-pane-grid-window-state(
        session_id: uuid,
        windows: list<pane-grid-window-request>,
    ) -> result<attach-pane-grid-window, attach-state-error>;

    query attach-pane-scrollback-pin(
        session_id: uuid,
        pane_id: uuid,
    ) -> result<pane-scrollback-pin, attach-state-error>;

    query attach-pane-scrollback-unpin(
        session_id: uuid,
        pane_id: uuid,
        pin_id: u64,
    ) -> result<pane-scrollback-unpin-ack, attach-state-error>;

    query attach-pane-grid-delta-state(
        session_id: uuid,
        pane_ids: list<uuid>,
        base_revisions: list<u64>,
        max_batches_per_pane: u32,
    ) -> result<attach-pane-grid-delta, attach-state-error>;

    record history-images-v1 {
        capture_id: uuid,
        // Complete replacement for this capture/window, including an empty list.
        // JSON-encoded Vec<AttachPaneImage> in the existing image wire format.
        encoded: list<u8>,
    }

    query attach-history-images-v1(
        session_id: uuid,
        pane_id: uuid,
        pin_id: u64,
        capture_id: uuid,
        width: u16,
        scrollback_offset: u32,
        rows: u16,
    ) -> result<history-images-v1, attach-state-error>;

    // Reflows captured anchors at width; offset is measured in projected rows.
    query attach-history-images-v2(
        session_id: uuid,
        pane_id: uuid,
        pin_id: u64,
        capture_id: uuid,
        width: u16,
        scrollback_offset: u32,
        rows: u16,
    ) -> result<history-images-v1, attach-state-error>;

    // Capture-wide logical origin, matching history/main-row slice assembly.
    // Complete replacement, clipped to this exact projected viewport.
    query attach-history-images-v3(
        session_id: uuid,
        pane_id: uuid,
        pin_id: u64,
        capture_id: uuid,
        width: u16,
        line_index: u32,
        column: u32,
        rows: u16,
    ) -> result<history-images-v1, attach-state-error>;

    query attach-pane-images(
        session_id: uuid,
        pane_ids: list<uuid>,
        since_sequences: list<u64>,
    ) -> result<attach-pane-images, attach-state-error>;
}

interface pane-runtime-events {
    enum attach-view-component {
        scene,
        surface-content,
        layout,
    }

    variant pane-event {
        client-attached { session_id: uuid },
        client-detached { session_id: uuid },
        exited { session_id: uuid, pane_id: uuid, reason: string? },
        restarted { session_id: uuid, pane_id: uuid },
        output-available { session_id: uuid, pane_id: uuid },
        image-available { session_id: uuid, pane_id: uuid },
        attach-view-changed {
            context_id: uuid?,
            session_id: uuid,
            revision: u64,
            components: list<attach-view-component>,
        },
    }

    events pane-event;
}

// Reactive state channel announcing the currently-focused pane (and
// the zoomed pane, if any) for every live session. Pane-runtime is
// the authoritative owner of this state; it publishes a fresh snapshot
// whenever any session's focus/zoom transitions, and also at attach
// time so newly-attached consumers observe the current state without
// an extra query round-trip.
//
// Payload semantics:
// - `entries` maps session-id to a per-session `focus-snapshot`. A
//   session with no entry means "no focus state observed yet"; most
//   consumers can ignore such gaps.
// - `focused_pane_id` is the pane currently receiving input focus.
// - `zoomed_pane_id` is the pane that has taken over the viewport
//   via zoom mode; `None` means not zoomed.
// - `revision` is a monotonic counter that advances on every publish;
//   consumers can use it to deduplicate or order updates.
//
// Subscribers use `EventBus::subscribe_state::<SessionFocusStateMap>`
// to obtain the current value synchronously plus a live-update
// receiver.
interface pane-runtime-focus {
    record focus-snapshot {
        focused_pane_id: uuid,
        zoomed_pane_id: uuid?,
    }

    record session-focus-state-map {
        entries: map<uuid, focus-snapshot>,
        revision: u64,
    }

    @state events session-focus-state-map;
}
