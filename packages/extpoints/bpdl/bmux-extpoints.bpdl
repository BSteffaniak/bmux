// Extension points the BMUX host program declares. They are product
// contracts, not framework ones: the generic host only stores, orders and
// routes contributions (`bmux_plugin::ExtensionPoints`). Plugins contribute
// with `Declarations::extend::<status_item_v1::Point>(data)` and implement
// the point's `Behavior`.
plugin bmux.extpoints version 1;

/// One segment of the status line. `order` sorts segments (ties break on
/// plugin id); `id` must be unique across contributors.
extension-point status-item version 1 {
    data {
        id: string,
        order: u32,
        /// Optional caption a host may show beside the segment.
        label: string?,
    }
    interface {
        /// Render the segment into at most `width` columns.
        query render(width: u16) -> string;
    }
}
