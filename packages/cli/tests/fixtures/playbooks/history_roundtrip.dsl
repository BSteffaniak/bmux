@timeout 60000
@driver real-attach
@sandbox-config packages/cli/tests/fixtures/playbooks/history_boundary.toml
@viewport cols=80 rows=24
@shell sh
@env-mode clean
new-session
send-keys keys='printf "\\e[2J\\e[H"; seq 1 50\r'
wait-for pattern='50'
send-attach key='ctrl+a ['
sleep ms=300
send-attach key='g'
sleep ms=150
assert-rendered contains='│1 '
send-attach key='shift+g'
sleep ms=150
send-attach key='ctrl+y'
sleep ms=150
send-attach key='ctrl+e'
sleep ms=150
assert-rendered contains='SCROLL'
assert-rendered contains='│50 '
send-attach key='g'
sleep ms=150
assert-rendered contains='│1 '
send-attach key='shift+g'
sleep ms=150
