# Need to set `stty sane` for fish
# https://github.com/direnv/direnv/issues/967#issuecomment-1987134113
if [[ $SHELL =~ "fish" ]]; then
  stty sane
fi

# Load optional project variables before the flake selects the compiler/cache.
dotenv_if_exists .env

# Automatically load the Nix flake development environment.
use flake
